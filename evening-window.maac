  note a12 { at = 15q; dur = 1q; pitch = C2; velocity = 0.56; }
}

pattern bass_b {
  length = 16q;
  note b1 { at = 0q; dur = 2q; pitch = D2; velocity = 0.70; }
  note b2 { at = 2q; dur = 2q; pitch = A2; velocity = 0.56; }
  note b3 { at = 4q; dur = 2q; pitch = C2; velocity = 0.68; }
