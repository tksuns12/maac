  length = 16q;
  note g1 { at = 0q; dur = 4q; pitch = G3; velocity = 0.70; }
  note g2 { at = 0q; dur = 4q; pitch = Bb3; velocity = 0.60; }
  note g3 { at = 0q; dur = 4q; pitch = D4; velocity = 0.60; }
