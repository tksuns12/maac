pattern chords_a {
  length = 16q;
  note d1 { at = 0q; dur = 4q; pitch = D3; velocity = 0.72; }
  note d2 { at = 0q; dur = 4q; pitch = F3; velocity = 0.62; }
  note d3 { at = 0q; dur = 4q; pitch = A3; velocity = 0.62; }
  note d4 { at = 0q; dur = 4q; pitch = C4; velocity = 0.56; }
  note bb1 { at = 4q; dur = 4q; pitch = Bb3; velocity = 0.70; }
  note bb2 { at = 4q; dur = 4q; pitch = D4; velocity = 0.60; }
  note bb3 { at = 4q; dur = 4q; pitch = F4; velocity = 0.60; }
  note bb4 { at = 4q; dur = 4q; pitch = A4; velocity = 0.55; }
  note f1 { at = 8q; dur = 4q; pitch = F3; velocity = 0.70; }
  note f2 { at = 8q; dur = 4q; pitch = A3; velocity = 0.60; }
  note f3 { at = 8q; dur = 4q; pitch = C4; velocity = 0.60; }
  note f4 { at = 8q; dur = 4q; pitch = E4; velocity = 0.54; }
  note c1 { at = 12q; dur = 4q; pitch = C3; velocity = 0.70; }
  note c2 { at = 12q; dur = 4q; pitch = E3; velocity = 0.60; }
  note c3 { at = 12q; dur = 4q; pitch = G3; velocity = 0.60; }
  note c4 { at = 12q; dur = 4q; pitch = D4; velocity = 0.54; }
}

