maac 1;

// Title: Evening Window
// Tempo: 96 bpm, 4/4 throughout. Form: A (bars 1-4), B (5-8), A' (9-12), coda (13-16).
// The B phrase uses shorter, off-beat melody fragments; the coda settles on D major.

project evening_window {
  label = "Evening Window";
  score = [0q, 64q];
  rate = 48000Hz;
  tempo = &clock;
  meter = &metre;
  output = &master:out;
  tail = 1s;
  seed = 1;
  requires = [];
}

tempo clock { points = [(0q, 96bpm, step)]; }
meter metre { points = [(0q, 4, 4)]; }

pattern melody_a {
  length = 16q;
  note a1 { at = 0q; dur = 1q; pitch = D5; velocity = 0.62; }
  note a2 { at = 1q; dur = 1/2q; pitch = F5; velocity = 0.56; }
  note a3 { at = 3/2q; dur = 1/2q; pitch = A5; velocity = 0.60; }
  note a4 { at = 2q; dur = 1q; pitch = C6; velocity = 0.60; }
  note a5 { at = 3q; dur = 1q; pitch = A5; velocity = 0.52; }
  note a6 { at = 4q; dur = 1/2q; pitch = Bb5; velocity = 0.58; }
  note a7 { at = 9/2q; dur = 1/2q; pitch = A5; velocity = 0.50; }
  note a8 { at = 5q; dur = 1q; pitch = F5; velocity = 0.56; }
  note a9 { at = 6q; dur = 1q; pitch = D5; velocity = 0.50; }
  note a10 { at = 7q; dur = 1q; pitch = F5; velocity = 0.55; }
  note a11 { at = 8q; dur = 1q; pitch = A5; velocity = 0.60; }
  note a12 { at = 9q; dur = 1/2q; pitch = G5; velocity = 0.48; }
  note a13 { at = 19/2q; dur = 1/2q; pitch = F5; velocity = 0.50; }
  note a14 { at = 10q; dur = 1q; pitch = E5; velocity = 0.55; }
  note a15 { at = 11q; dur = 1q; pitch = C5; velocity = 0.50; }
  note a16 { at = 12q; dur = 1/2q; pitch = D5; velocity = 0.52; }
  note a17 { at = 25/2q; dur = 1/2q; pitch = E5; velocity = 0.56; }
  note a18 { at = 13q; dur = 1q; pitch = G5; velocity = 0.60; }
  note a19 { at = 14q; dur = 1q; pitch = E5; velocity = 0.50; }
  note a20 { at = 15q; dur = 1q; pitch = D5; velocity = 0.55; }
}

