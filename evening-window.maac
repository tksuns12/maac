}

pattern bass_a {
  length = 16q;
  note a1 { at = 0q; dur = 2q; pitch = D2; velocity = 0.72; }
  note a2 { at = 2q; dur = 1q; pitch = A2; velocity = 0.56; }
  note a3 { at = 3q; dur = 1q; pitch = A2; velocity = 0.52; }
  note a4 { at = 4q; dur = 2q; pitch = Bb1; velocity = 0.68; }
  note a5 { at = 6q; dur = 1q; pitch = F2; velocity = 0.52; }
  note a6 { at = 7q; dur = 1q; pitch = Bb1; velocity = 0.54; }
  note a7 { at = 8q; dur = 2q; pitch = F2; velocity = 0.68; }
