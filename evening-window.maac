  note a1 { at = 4q; dur = 4q; pitch = A3; velocity = 0.72; }
  note a2 { at = 4q; dur = 4q; pitch = C#4; velocity = 0.64; }
  note a3 { at = 4q; dur = 4q; pitch = E4; velocity = 0.62; }
