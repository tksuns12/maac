}

pattern bass_coda {
  length = 16q;
  note c1 { at = 0q; dur = 2q; pitch = G1; velocity = 0.68; }
  note c2 { at = 2q; dur = 2q; pitch = D2; velocity = 0.54; }
  note c3 { at = 4q; dur = 2q; pitch = A1; velocity = 0.70; }
  note c4 { at = 6q; dur = 2q; pitch = E2; velocity = 0.54; }
  note c5 { at = 8q; dur = 2q; pitch = D2; velocity = 0.70; }
  note c6 { at = 10q; dur = 2q; pitch = A2; velocity = 0.56; }
  note c7 { at = 12q; dur = 4q; pitch = D2; velocity = 0.74; }
}

track melody { target = &melody_synth:events; }
track chords { target = &chord_synth:events; }
track bass { target = &bass_synth:events; }

place melody_a_main {
  pattern = &melody_a;
  track = &melody;
  at = 0q;
  count = 1;
  stretch = 1;
  transpose = 0ct;
  boundary = spill;
}

place melody_b_main {
  pattern = &melody_b;
  track = &melody;
  at = 16q;
  count = 1;
  stretch = 1;
  transpose = 0ct;
  boundary = spill;
}

place melody_a_prime_main {
  pattern = &melody_a_prime;
  track = &melody;
  at = 32q;
  count = 1;
  stretch = 1;
  transpose = 0ct;
  boundary = spill;
}

place melody_coda_main {
  pattern = &melody_coda;
  track = &melody;
  at = 48q;
  count = 1;
  stretch = 1;
  transpose = 0ct;
  boundary = spill;
}

place chords_a_first {
  pattern = &chords_a;
  track = &chords;
  at = 0q;
  count = 1;
  stretch = 1;
  transpose = 0ct;
  boundary = spill;
}

place chords_b_middle {
  pattern = &chords_b;
  track = &chords;
  at = 16q;
  count = 1;
  stretch = 1;
  transpose = 0ct;
  boundary = spill;
}

place chords_a_reprise {
  pattern = &chords_a;
  track = &chords;
  at = 32q;
  count = 1;
  stretch = 1;
  transpose = 0ct;
  boundary = spill;
}

place chords_coda_main {
  pattern = &chords_coda;
  track = &chords;
  at = 48q;
  count = 1;
  stretch = 1;
  transpose = 0ct;
  boundary = spill;
}

place bass_a_first {
  pattern = &bass_a;
  track = &bass;
  at = 0q;
  count = 1;
  stretch = 1;
  transpose = 0ct;
  boundary = spill;
}

place bass_b_middle {
  pattern = &bass_b;
  track = &bass;
  at = 16q;
  count = 1;
  stretch = 1;
  transpose = 0ct;
  boundary = spill;
}

place bass_a_reprise {
  pattern = &bass_a;
  track = &bass;
  at = 32q;
  count = 1;
  stretch = 1;
  transpose = 0ct;
  boundary = spill;
}

place bass_coda_main {
  pattern = &bass_coda;
  track = &bass;
  at = 48q;
  count = 1;
  stretch = 1;
  transpose = 0ct;
  boundary = spill;
}

node melody_synth {
  type = "core.sine/1";
  config = { voices = 8; };
  params = { attack = 12ms; release = 180ms; level = 0.14; };
}

node melody_pan {
  type = "core.pan/1";
  params = { pan = -0.18; };
}

node chord_synth {
  type = "core.sine/1";
  config = { voices = 16; };
  params = { attack = 35ms; release = 260ms; level = 0.09; };
}

node chord_pan {
  type = "core.pan/1";
  params = { pan = 0; };
}

node bass_synth {
  type = "core.sine/1";
  config = { voices = 8; };
  params = { attack = 6ms; release = 140ms; level = 0.17; };
}

node bass_pan {
  type = "core.pan/1";
  params = { pan = 0.12; };
}

node master {
  type = "core.sum/1";
  config = { channels = 2; };
}

connect melody_to_pan { from = &melody_synth:out; to = &melody_pan:in; }
connect melody_to_master { from = &melody_pan:out; to = &master:in; }
connect chords_to_pan { from = &chord_synth:out; to = &chord_pan:in; }
connect chords_to_master { from = &chord_pan:out; to = &master:in; }
connect bass_to_pan { from = &bass_synth:out; to = &bass_pan:in; }
connect bass_to_master { from = &bass_pan:out; to = &master:in; }

region section_a { span = [0q, 16q]; label = "A"; }
region section_b { span = [16q, 32q]; label = "B"; }
region section_a_prime { span = [32q, 48q]; label = "A prime"; }
region section_coda { span = [48q, 64q]; label = "Coda - D major resolution"; }
