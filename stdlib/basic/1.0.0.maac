    channels = 2;
    output = &pan:out;
    node soften { type = "synth.onepole/1"; config = { channels = 1; }; params = { cutoff = 7000Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.30; }; }
    node pan { type = "synth.pan/1"; params = { pan = 0; }; }
    connect input_soften { from = &input:out; to = &soften:in; }
    connect soften_gain { from = &soften:out; to = &gain:in; }
    connect gain_pan { from = &gain:out; to = &pan:in; }
  }
  control level { target = &output.gain.params.level; default = 0.30; }
  control brightness { target = &output.soften.params.cutoff; default = 7000Hz; }
  control release { target = &voice.amp.params.release; default = 180ms; }
  control pan { target = &output.pan.params.pan; default = 0; }
}
