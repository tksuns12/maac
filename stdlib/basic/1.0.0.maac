// Long noise wash with bounded inharmonic FM and a square-wave edge.
instrument crash {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &highpass:out;
    node amp { type = "synth.adsr/1"; params = { attack = 2ms; decay = 1800ms; sustain = 0; release = 650ms; }; }
    node noise { type = "synth.noise/1"; config = { seed = 1414213562; }; params = { level = 0.8; }; }
    node modulator { type = "synth.sine/1"; params = { ratio = 0; frequency = 2311Hz; level = 1; }; }
    node metal { type = "synth.sine/1"; params = { ratio = 0; frequency = 1600Hz; level = 0.25; }; }
    modulate metal_fm { from = &modulator:out; to = &metal.params.frequency; depth = 700Hz; }
    node edge_partial { type = "synth.square/1"; params = { ratio = 0; frequency = 913Hz; level = 0.16; }; }
    node mix { type = "synth.mix/1"; config = { channels = 1; }; }
    node highpass { type = "synth.highpass/1"; config = { channels = 1; }; params = { cutoff = 2000Hz; }; }
    connect noise_mix { from = &noise:out; to = &mix:in; }
    connect metal_mix { from = &metal:out; to = &mix:in; }
    connect edge_mix { from = &edge_partial:out; to = &mix:in; }
    connect mix_highpass { from = &mix:out; to = &highpass:in; }
  }
  shared output {
    channels = 2;
    output = &pan:out;
    node tone { type = "synth.onepole/1"; config = { channels = 1; }; params = { cutoff = 12000Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.28; }; }
    node pan { type = "synth.pan/1"; params = { pan = 0; }; }
    connect input_tone { from = &input:out; to = &tone:in; }
    connect tone_gain { from = &tone:out; to = &gain:in; }
    connect gain_pan { from = &gain:out; to = &pan:in; }
  }
  control level { target = &output.gain.params.level; default = 0.28; }
  control brightness { target = &output.tone.params.cutoff; default = 12000Hz; }
  control release { target = &voice.amp.params.release; default = 650ms; }
  control pan { target = &output.pan.params.pan; default = 0; }
}


// Soft triangle body with gently decaying harmonic FM; a synthesized piano interpretation.
instrument mellow_piano {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &blend:out;
    node amp { type = "synth.adsr/1"; params = { attack = 4ms; decay = 1500ms; sustain = 0.12; release = 360ms; }; }
    node blend { type = "synth.mix/1"; config = { channels = 1; }; }
    node timbre { type = "synth.adsr/1"; params = { attack = 2ms; decay = 220ms; sustain = 0; release = 120ms; }; }
    node modulator { type = "synth.sine/1"; params = { ratio = 2; }; }
    node transient { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0; }; }
    node carrier { type = "synth.sine/1"; params = { ratio = 1; level = 0.42; }; }
    node body { type = "synth.triangle/1"; params = { level = 0.58; }; }
    connect modulator_transient { from = &modulator:out; to = &transient:in; }
    modulate timbre_transient { from = &timbre:out; to = &transient.params.level; depth = 1; }
    modulate transient_carrier { from = &transient:out; to = &carrier.params.frequency; depth = 100Hz; }
    connect carrier_blend { from = &carrier:out; to = &blend:in; }
    connect body_blend { from = &body:out; to = &blend:in; }
  }
  shared output {
    channels = 2;
    output = &pan:out;
    node soften { type = "synth.onepole/1"; config = { channels = 1; }; params = { cutoff = 4200Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.16; }; }
    node pan { type = "synth.pan/1"; params = { pan = 0; }; }
    connect input_soften { from = &input:out; to = &soften:in; }
    connect soften_gain { from = &soften:out; to = &gain:in; }
    connect gain_pan { from = &gain:out; to = &pan:in; }
  }
  control level { target = &output.gain.params.level; default = 0.16; }
  control brightness { target = &output.soften.params.cutoff; default = 4200Hz; }
  control release { target = &voice.amp.params.release; default = 360ms; }
  control pan { target = &output.pan.params.pan; default = 0; }
}

// Brisk triangle body and stronger third-harmonic FM attack; a synthesized bright piano interpretation.
instrument bright_piano {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &blend:out;
    node amp { type = "synth.adsr/1"; params = { attack = 3ms; decay = 1100ms; sustain = 0.1; release = 280ms; }; }
    node blend { type = "synth.mix/1"; config = { channels = 1; }; }
    node timbre { type = "synth.adsr/1"; params = { attack = 2ms; decay = 160ms; sustain = 0; release = 120ms; }; }
    node modulator { type = "synth.sine/1"; params = { ratio = 3; }; }
    node transient { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0; }; }
    node carrier { type = "synth.sine/1"; params = { ratio = 1; level = 0.62; }; }
    node body { type = "synth.triangle/1"; params = { level = 0.38; }; }
    connect modulator_transient { from = &modulator:out; to = &transient:in; }
    modulate timbre_transient { from = &timbre:out; to = &transient.params.level; depth = 1; }
    modulate transient_carrier { from = &transient:out; to = &carrier.params.frequency; depth = 420Hz; }
    connect carrier_blend { from = &carrier:out; to = &blend:in; }
    connect body_blend { from = &body:out; to = &blend:in; }
  }
  shared output {
    channels = 2;
    output = &pan:out;
    node soften { type = "synth.onepole/1"; config = { channels = 1; }; params = { cutoff = 11000Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.16; }; }
    node pan { type = "synth.pan/1"; params = { pan = 0; }; }
    connect input_soften { from = &input:out; to = &soften:in; }
    connect soften_gain { from = &soften:out; to = &gain:in; }
    connect gain_pan { from = &gain:out; to = &pan:in; }
  }
  control level { target = &output.gain.params.level; default = 0.16; }
  control brightness { target = &output.soften.params.cutoff; default = 11000Hz; }
  control release { target = &voice.amp.params.release; default = 280ms; }
  control pan { target = &output.pan.params.pan; default = 0; }
}

// Rounded sine fundamental with an envelope-shaped FM octave tine; a synthesized electric piano interpretation.
instrument electric_piano {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &blend:out;
    node amp { type = "synth.adsr/1"; params = { attack = 5ms; decay = 1800ms; sustain = 0.18; release = 600ms; }; }
    node blend { type = "synth.mix/1"; config = { channels = 1; }; }
    node timbre { type = "synth.adsr/1"; params = { attack = 2ms; decay = 500ms; sustain = 0; release = 120ms; }; }
    node modulator { type = "synth.sine/1"; params = { ratio = 1; }; }
    node transient { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0; }; }
    node carrier { type = "synth.sine/1"; params = { ratio = 2; level = 0.32; }; }
    node body { type = "synth.sine/1"; params = { level = 0.68; }; }
    connect modulator_transient { from = &modulator:out; to = &transient:in; }
    modulate timbre_transient { from = &timbre:out; to = &transient.params.level; depth = 1; }
    modulate transient_carrier { from = &transient:out; to = &carrier.params.frequency; depth = 300Hz; }
    connect carrier_blend { from = &carrier:out; to = &blend:in; }
    connect body_blend { from = &body:out; to = &blend:in; }
  }
  shared output {
    channels = 2;
    output = &pan:out;
    node soften { type = "synth.onepole/1"; config = { channels = 1; }; params = { cutoff = 6500Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.16; }; }
    node pan { type = "synth.pan/1"; params = { pan = 0; }; }
    connect input_soften { from = &input:out; to = &soften:in; }
    connect soften_gain { from = &soften:out; to = &gain:in; }
    connect gain_pan { from = &gain:out; to = &pan:in; }
  }
  control level { target = &output.gain.params.level; default = 0.16; }
  control brightness { target = &output.soften.params.cutoff; default = 6500Hz; }
  control release { target = &voice.amp.params.release; default = 600ms; }
  control pan { target = &output.pan.params.pan; default = 0; }
}

// Sustained additive drawbar-like harmonic blend; a synthesized organ interpretation without rotary effects.
instrument organ {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &blend:out;
    node amp { type = "synth.adsr/1"; params = { attack = 12ms; decay = 80ms; sustain = 0.92; release = 110ms; }; }
    node blend { type = "synth.mix/1"; config = { channels = 1; }; }
    node partial_1 { type = "synth.sine/1"; params = { ratio = 1; level = 0.65; }; }
    connect partial_1_blend { from = &partial_1:out; to = &blend:in; }
    node partial_2 { type = "synth.sine/1"; params = { ratio = 2; level = 0.24; }; }
    connect partial_2_blend { from = &partial_2:out; to = &blend:in; }
    node partial_3 { type = "synth.sine/1"; params = { ratio = 3; level = 0.13; }; }
    connect partial_3_blend { from = &partial_3:out; to = &blend:in; }
    node partial_4 { type = "synth.sine/1"; params = { ratio = 4; level = 0.08; }; }
    connect partial_4_blend { from = &partial_4:out; to = &blend:in; }
  }
  shared output {
    channels = 2;
    output = &pan:out;
    node soften { type = "synth.onepole/1"; config = { channels = 1; }; params = { cutoff = 9000Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.14; }; }
    node pan { type = "synth.pan/1"; params = { pan = 0; }; }
    connect input_soften { from = &input:out; to = &soften:in; }
    connect soften_gain { from = &soften:out; to = &gain:in; }
    connect gain_pan { from = &gain:out; to = &pan:in; }
  }
  control level { target = &output.gain.params.level; default = 0.14; }
  control brightness { target = &output.soften.params.cutoff; default = 9000Hz; }
  control release { target = &voice.amp.params.release; default = 110ms; }
  control pan { target = &output.pan.params.pan; default = 0; }
}


// Synthesized nylon-string interpretation: rounded sine/triangle body with a brief harmonic FM pluck.
instrument nylon_guitar {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &body_mix:out;
    node amp {
      type = "synth.adsr/1";
      params = { attack = 3ms; decay = 1250ms; sustain = 0; release = 160ms; };
    }
    node pluck {
      type = "synth.adsr/1";
      params = { attack = 1ms; decay = 85ms; sustain = 0; release = 45ms; };
    }
    node modulator { type = "synth.sine/1"; params = { ratio = 2; }; }
    node transient {
      type = "synth.gain/1";
      config = { channels = 1; };
      params = { level = 0; };
    }
    node string { type = "synth.sine/1"; params = { level = 0.8; }; }
    node body { type = "synth.triangle/1"; params = { level = 0.25; }; }
    node body_mix { type = "synth.mix/1"; config = { channels = 1; }; }
    connect modulator_transient { from = &modulator:out; to = &transient:in; }
    connect string_mix { from = &string:out; to = &body_mix:in; }
    connect body_mix_input { from = &body:out; to = &body_mix:in; }
    modulate pluck_amount { from = &pluck:out; to = &transient.params.level; depth = 1; }
    modulate pluck_fm { from = &transient:out; to = &string.params.frequency; depth = 150Hz; }
  }
  shared tone {
    channels = 2;
    output = &output_gain:out;
    node filter {
      type = "synth.onepole/1";
      config = { channels = 1; };
      params = { cutoff = 3500Hz; };
    }
    node stereo { type = "synth.pan/1"; params = { pan = 0; }; }
    node output_gain {
      type = "synth.gain/1";
      config = { channels = 2; };
      params = { level = 0.14; };
    }
    connect input_filter { from = &input:out; to = &filter:in; }
    connect filter_stereo { from = &filter:out; to = &stereo:in; }
    connect stereo_output { from = &stereo:out; to = &output_gain:in; }
  }
  control level { target = &tone.output_gain.params.level; default = 0.14; }
  control brightness { target = &tone.filter.params.cutoff; default = 3500Hz; }
  control release { target = &voice.amp.params.release; default = 160ms; }
  control pan { target = &tone.stereo.params.pan; default = 0; }
}

