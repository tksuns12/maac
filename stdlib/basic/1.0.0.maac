maac 1;
library basic { version = "1.0.0"; creator = "MaaC project"; license = "Apache-2.0"; }


// Deep sine pitch drop with a brief filtered noise beater.
instrument kick {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &mix:out;
    node amp { type = "synth.adsr/1"; params = { attack = 1ms; decay = 240ms; sustain = 0; release = 90ms; }; }
    node body { type = "synth.sine/1"; params = { ratio = 0; frequency = 52Hz; level = 1; }; }
    node drop { type = "synth.adsr/1"; params = { attack = 1ms; decay = 38ms; sustain = 0; release = 25ms; }; }
    modulate pitch_drop { from = &drop:out; to = &body.params.frequency; depth = 105Hz; }
    node noise { type = "synth.noise/1"; config = { seed = 1831565813; }; params = { level = 0.16; }; }
    node click_highpass { type = "synth.highpass/1"; config = { channels = 1; }; params = { cutoff = 2200Hz; }; }
    node click_env { type = "synth.adsr/1"; params = { attack = 0.5ms; decay = 12ms; sustain = 0; release = 8ms; }; }
    node click_gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0; }; }
    modulate click_shape { from = &click_env:out; to = &click_gain.params.level; depth = 1; }
    node mix { type = "synth.mix/1"; config = { channels = 1; }; }
    connect noise_highpass { from = &noise:out; to = &click_highpass:in; }
    connect highpass_gain { from = &click_highpass:out; to = &click_gain:in; }
    connect click_mix { from = &click_gain:out; to = &mix:in; }
    connect body_mix { from = &body:out; to = &mix:in; }
  }
  shared output {
    channels = 2;
    output = &pan:out;
    node tone { type = "synth.onepole/1"; config = { channels = 1; }; params = { cutoff = 3500Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.25; }; }
    node pan { type = "synth.pan/1"; params = { pan = 0; }; }
    connect input_tone { from = &input:out; to = &tone:in; }
    connect tone_gain { from = &tone:out; to = &gain:in; }
    connect gain_pan { from = &gain:out; to = &pan:in; }
  }
  control level { target = &output.gain.params.level; default = 0.25; }
  control brightness { target = &output.tone.params.cutoff; default = 3500Hz; }
  control release { target = &voice.amp.params.release; default = 90ms; }
  control pan { target = &output.pan.params.pan; default = 0; }
}

// Falling sine shell under a bright high-passed noise wire burst.
instrument snare {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &mix:out;
    node amp { type = "synth.adsr/1"; params = { attack = 1ms; decay = 210ms; sustain = 0; release = 80ms; }; }
    node body { type = "synth.sine/1"; params = { ratio = 0; frequency = 175Hz; level = 0.45; }; }
    node drop { type = "synth.adsr/1"; params = { attack = 1ms; decay = 32ms; sustain = 0; release = 20ms; }; }
    modulate pitch_drop { from = &drop:out; to = &body.params.frequency; depth = 65Hz; }
    node noise { type = "synth.noise/1"; config = { seed = 2718281828; }; params = { level = 0.9; }; }
    node wires { type = "synth.highpass/1"; config = { channels = 1; }; params = { cutoff = 1400Hz; }; }
    node mix { type = "synth.mix/1"; config = { channels = 1; }; }
    connect noise_wires { from = &noise:out; to = &wires:in; }
    connect wires_mix { from = &wires:out; to = &mix:in; }
    connect body_mix { from = &body:out; to = &mix:in; }
  }
  shared output {
    channels = 2;
    output = &pan:out;
    node tone { type = "synth.onepole/1"; config = { channels = 1; }; params = { cutoff = 8500Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.24; }; }
    node pan { type = "synth.pan/1"; params = { pan = 0; }; }
    connect input_tone { from = &input:out; to = &tone:in; }
    connect tone_gain { from = &tone:out; to = &gain:in; }
    connect gain_pan { from = &gain:out; to = &pan:in; }
  }
  control level { target = &output.gain.params.level; default = 0.24; }
  control brightness { target = &output.tone.params.cutoff; default = 8500Hz; }
  control release { target = &voice.amp.params.release; default = 80ms; }
  control pan { target = &output.pan.params.pan; default = 0; }
}

// Broad filtered noise with rapid amplitude flutter for a synthetic handclap.
instrument clap {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &flutter_gain:out;
    node amp { type = "synth.adsr/1"; params = { attack = 0.7ms; decay = 260ms; sustain = 0; release = 100ms; }; }
    node noise { type = "synth.noise/1"; config = { seed = 3141592653; }; params = { level = 1; }; }
    node hands { type = "synth.highpass/1"; config = { channels = 1; }; params = { cutoff = 800Hz; }; }
    node flutter { type = "synth.lfo/1"; params = { frequency = 45Hz; phase = 0.25; level = 1; }; }
    node flutter_gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.75; }; }
    modulate flutter_shape { from = &flutter:out; to = &flutter_gain.params.level; depth = 0.25; }
    connect noise_hands { from = &noise:out; to = &hands:in; }
    connect hands_flutter { from = &hands:out; to = &flutter_gain:in; }
  }
  shared output {
    channels = 2;
    output = &pan:out;
    node tone { type = "synth.onepole/1"; config = { channels = 1; }; params = { cutoff = 6000Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.34; }; }
    node pan { type = "synth.pan/1"; params = { pan = 0; }; }
    connect input_tone { from = &input:out; to = &tone:in; }
    connect tone_gain { from = &tone:out; to = &gain:in; }
    connect gain_pan { from = &gain:out; to = &pan:in; }
  }
  control level { target = &output.gain.params.level; default = 0.34; }
  control brightness { target = &output.tone.params.cutoff; default = 6000Hz; }
  control release { target = &voice.amp.params.release; default = 100ms; }
  control pan { target = &output.pan.params.pan; default = 0; }
}

// Tightly damped high-passed noise and inharmonic square-wave metal.
instrument closed_hat {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &edge:out;
    node amp { type = "synth.adsr/1"; params = { attack = 0.6ms; decay = 85ms; sustain = 0; release = 25ms; }; }
    node noise { type = "synth.noise/1"; config = { seed = 1618033988; }; params = { level = 0.8; }; }
    node metal_a { type = "synth.square/1"; params = { ratio = 0; frequency = 407Hz; level = 0.12; }; }
    node metal_b { type = "synth.square/1"; params = { ratio = 0; frequency = 587Hz; level = 0.12; }; }
    node mix { type = "synth.mix/1"; config = { channels = 1; }; }
    node edge { type = "synth.highpass/1"; config = { channels = 1; }; params = { cutoff = 5500Hz; }; }
    connect noise_mix { from = &noise:out; to = &mix:in; }
    connect metal_a_mix { from = &metal_a:out; to = &mix:in; }
    connect metal_b_mix { from = &metal_b:out; to = &mix:in; }
    connect mix_edge { from = &mix:out; to = &edge:in; }
  }
  shared output {
    channels = 2;
    output = &pan:out;
    node tone { type = "synth.onepole/1"; config = { channels = 1; }; params = { cutoff = 10500Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.6; }; }
    node pan { type = "synth.pan/1"; params = { pan = 0; }; }
    connect input_tone { from = &input:out; to = &tone:in; }
    connect tone_gain { from = &tone:out; to = &gain:in; }
    connect gain_pan { from = &gain:out; to = &pan:in; }
  }
  control level { target = &output.gain.params.level; default = 0.6; }
  control brightness { target = &output.tone.params.cutoff; default = 10500Hz; }
  control release { target = &voice.amp.params.release; default = 25ms; }
  control pan { target = &output.pan.params.pan; default = 0; }
}

// Longer ringing high-passed noise and inharmonic square-wave metal.
instrument open_hat {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &edge:out;
    node amp { type = "synth.adsr/1"; params = { attack = 0.6ms; decay = 900ms; sustain = 0; release = 180ms; }; }
    node noise { type = "synth.noise/1"; config = { seed = 1618033988; }; params = { level = 0.8; }; }
    node metal_a { type = "synth.square/1"; params = { ratio = 0; frequency = 407Hz; level = 0.12; }; }
    node metal_b { type = "synth.square/1"; params = { ratio = 0; frequency = 587Hz; level = 0.12; }; }
    node mix { type = "synth.mix/1"; config = { channels = 1; }; }
    node edge { type = "synth.highpass/1"; config = { channels = 1; }; params = { cutoff = 4500Hz; }; }
    connect noise_mix { from = &noise:out; to = &mix:in; }
    connect metal_a_mix { from = &metal_a:out; to = &mix:in; }
    connect metal_b_mix { from = &metal_b:out; to = &mix:in; }
    connect mix_edge { from = &mix:out; to = &edge:in; }
  }
  shared output {
    channels = 2;
    output = &pan:out;
    node tone { type = "synth.onepole/1"; config = { channels = 1; }; params = { cutoff = 12000Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.44; }; }
    node pan { type = "synth.pan/1"; params = { pan = 0; }; }
    connect input_tone { from = &input:out; to = &tone:in; }
    connect tone_gain { from = &tone:out; to = &gain:in; }
    connect gain_pan { from = &gain:out; to = &pan:in; }
  }
  control level { target = &output.gain.params.level; default = 0.44; }
  control brightness { target = &output.tone.params.cutoff; default = 12000Hz; }
  control release { target = &voice.amp.params.release; default = 180ms; }
  control pan { target = &output.pan.params.pan; default = 0; }
}

// Falling tuned sine drum with an inharmonic skin overtone.
instrument low_tom {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &mix:out;
    node amp { type = "synth.adsr/1"; params = { attack = 2ms; decay = 480ms; sustain = 0; release = 150ms; }; }
    node body { type = "synth.sine/1"; params = { ratio = 0; frequency = 105Hz; level = 0.85; }; }
    node skin { type = "synth.sine/1"; params = { ratio = 0; frequency = 173Hz; level = 0.18; }; }
    node drop { type = "synth.adsr/1"; params = { attack = 1ms; decay = 55ms; sustain = 0; release = 30ms; }; }
    modulate pitch_drop { from = &drop:out; to = &body.params.frequency; depth = 65Hz; }
    node mix { type = "synth.mix/1"; config = { channels = 1; }; }
    connect body_mix { from = &body:out; to = &mix:in; }
    connect skin_mix { from = &skin:out; to = &mix:in; }
  }
  shared output {
    channels = 2;
    output = &pan:out;
    node tone { type = "synth.onepole/1"; config = { channels = 1; }; params = { cutoff = 5000Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.25; }; }
    node pan { type = "synth.pan/1"; params = { pan = 0; }; }
    connect input_tone { from = &input:out; to = &tone:in; }
    connect tone_gain { from = &tone:out; to = &gain:in; }
    connect gain_pan { from = &gain:out; to = &pan:in; }
  }
  control level { target = &output.gain.params.level; default = 0.25; }
  control brightness { target = &output.tone.params.cutoff; default = 5000Hz; }
  control release { target = &voice.amp.params.release; default = 150ms; }
  control pan { target = &output.pan.params.pan; default = 0; }
}

