  phrase p3 { at = 16q; length = 15q; dynamics = &arc_long; pressure = &breath_long; }
}

// The tag: the last turnaround, then a held D over Bbmaj9.
pattern tag_line { length = 16q;
  note n1 { at = 1/2q; dur = 1/2q; pitch = G3; velocity = 0.6; expression s { kind = pitch; curve = &scoop; } }
  note n2 { at = after(n1); dur = 1/2q; pitch = Bb3; velocity = 0.54; slur = true; expression s { kind = pitch; curve = &scoop; } }
  note n3 { at = after(n2); dur = 1/2q; pitch = D4; velocity = 0.68; expression s { kind = pitch; curve = &scoop; } }
  note n4 { at = after(n3); dur = 1/2q; pitch = C4; velocity = 0.56; slur = true; expression s { kind = pitch; curve = &scoop; } }
  note n5 { at = after(n4); dur = 1/2q; pitch = A3; velocity = 0.66; expression s { kind = pitch; curve = &scoop; } }
  note n6 { at = after(n5); dur = 1/2q; pitch = F3; velocity = 0.54; slur = true; expression s { kind = pitch; curve = &scoop; } }
  note n7 { at = after(n6); dur = 1/2q; pitch = Eb3; velocity = 0.64; expression s { kind = pitch; curve = &scoop; } }
  note n8 { at = after(n7); dur = 1/2q; pitch = D3; velocity = 0.54; slur = true; expression s { kind = pitch; curve = &scoop; } }
  note n9 { at = after(n8); dur = 1/2q; pitch = F3; velocity = 0.64; expression s { kind = pitch; curve = &scoop; } }
  note n10 { at = after(n9); dur = 1/2q; pitch = A3; velocity = 0.56; slur = true; expression s { kind = pitch; curve = &scoop; } }
  note n11 { at = after(n10); dur = 1/2q; pitch = C4; velocity = 0.68; expression s { kind = pitch; curve = &scoop; } }
  note n12 { at = after(n11); dur = 1/2q; pitch = B3; velocity = 0.56; slur = true; expression s { kind = pitch; curve = &scoop; } }
  note n13 { at = after(n12); dur = 1/2q; pitch = Ab3; velocity = 0.66; expression s { kind = pitch; curve = &scoop; } }
  note n14 { at = after(n13); dur = 1/2q; pitch = F3; velocity = 0.54; slur = true; expression s { kind = pitch; curve = &scoop; } }
  note n15 { at = after(n14); dur = 1/2q; pitch = D3; velocity = 0.64; expression s { kind = pitch; curve = &scoop; } }
  note n16 { at = after(n15); dur = 4/5q; pitch = Eb3; velocity = 0.62; slur = true; }
  note n17 { at = after(n16, 1/5q); dur = 1/2q; pitch = G3; velocity = 0.56; expression s { kind = pitch; curve = &scoop; } }
  note n18 { at = after(n17); dur = 1/2q; pitch = Bb3; velocity = 0.66; expression s { kind = pitch; curve = &scoop; } }
  note n19 { at = after(n18); dur = 4/5q; pitch = A3; velocity = 0.64; slur = true; }
  note n20 { at = after(n19, 1/5q); dur = 4/5q; pitch = C4; velocity = 0.68; }
  note n21 { at = after(n20, 1/5q); dur = 4q; pitch = D4; velocity = 0.7; expression v { kind = pitch; vibrato = &sax_vib; } }
  phrase p1 { at = 1/2q; length = 8q; dynamics = &arc_mid; pressure = &breath_mid; }
  phrase p2 { at = 9q; length = 7q; dynamics = &arc_short; pressure = &breath_end; }
}

