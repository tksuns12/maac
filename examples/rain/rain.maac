// ---------------------------------------------------------------- the band
node sax { instrument = &tenor_sax; config = { voices = 6; }; params = { pan = -0.05; level = 0.63; }; }
node piano { instrument = &studio.piano; config = { voices = 24; }; params = { level = 2.2; }; }
node bass { instrument = &upright_bass; config = { voices = 6; }; params = { level = 0.5; }; }
node ride { instrument = &ride_cymbal; config = { voices = 32; }; params = { level = 1.06; }; }
node kit { instrument = &studio.drums; params = { snare_level = 1.3; snare_brightness = 6000Hz; snare_pan = 0.15; hat_level = 3.1; hat_brightness = 9000Hz; hat_pan = 0.3; kick_level = 1.2; kick_brightness = 2500Hz; }; }

track sax_notes { target = &sax:events; }
track piano_notes { target = &piano:events; }
track bass_notes { target = &bass:events; }
track ride_notes { target = &ride:events; }
track kit_notes { target = &kit:events; }

// ---------------------------------------------------------------- arrangement
place sax_head_a1 { pattern = &head_a; track = &sax_notes; at = 16q; groove = &swing; }
place sax_head_a2 { pattern = &head_a2; track = &sax_notes; at = 48q; groove = &swing; }
place sax_head_b { pattern = &head_b; track = &sax_notes; at = 80q; groove = &swing; }
place sax_head_a3 { pattern = &head_a_r2; track = &sax_notes; at = 112q; groove = &swing; }
place sax_solo_a1 { pattern = &solo_a1; track = &sax_notes; at = 144q; groove = &swing; }
place sax_solo_a2 { pattern = &solo_a2; track = &sax_notes; at = 176q; groove = &swing; }
place sax_solo_b { pattern = &solo_b; track = &sax_notes; at = 208q; groove = &swing; }
place sax_solo_a3 { pattern = &solo_a3; track = &sax_notes; at = 240q; groove = &swing; }
place sax_out_b { pattern = &head_b_r2; track = &sax_notes; at = 272q; groove = &swing; }
place sax_out_a3 { pattern = &head_a_r3; track = &sax_notes; at = 304q; groove = &swing; }
place sax_tag { pattern = &tag_line; track = &sax_notes; at = 336q; groove = &swing; }
place bass_intro { pattern = &walk_intro; track = &bass_notes; at = 0q; }
place bass_a1 { pattern = &walk_a; track = &bass_notes; at = 16q; }
place bass_a2 { pattern = &walk_a2; track = &bass_notes; at = 48q; }
place bass_b { pattern = &walk_b; track = &bass_notes; at = 80q; }
place bass_a3 { pattern = &walk_a; track = &bass_notes; at = 112q; }
place bass_solo_a1 { pattern = &walk_solo_a; track = &bass_notes; at = 144q; }
place bass_solo_a2 { pattern = &walk_solo_a2; track = &bass_notes; at = 176q; }
place bass_solo_b { pattern = &walk_solo_b; track = &bass_notes; at = 208q; }
place bass_solo_a3 { pattern = &walk_solo_a; track = &bass_notes; at = 240q; }
place bass_out_b { pattern = &walk_b; track = &bass_notes; at = 272q; }
place bass_out_a3 { pattern = &walk_a; track = &bass_notes; at = 304q; }
place bass_tag { pattern = &walk_tag; track = &bass_notes; at = 336q; }
place piano_intro { pattern = &comp_intro; track = &piano_notes; at = 0q; harmony = &intro_chords; voicings = &piano_voicings; groove = &swing; }
place piano_a1 { pattern = &comp_a; track = &piano_notes; at = 16q; harmony = &a_chords; voicings = &piano_voicings; groove = &swing; }
place piano_a2 { pattern = &comp_a; track = &piano_notes; at = 48q; harmony = &a2_chords; voicings = &piano_voicings; groove = &swing; }
place piano_b { pattern = &comp_b; track = &piano_notes; at = 80q; harmony = &b_chords; voicings = &piano_voicings; groove = &swing; }
place piano_a3 { pattern = &comp_a; track = &piano_notes; at = 112q; harmony = &a_chords; voicings = &piano_voicings; groove = &swing; }
place piano_solo_a1 { pattern = &comp_solo_a; track = &piano_notes; at = 144q; harmony = &a_chords; voicings = &piano_voicings; groove = &swing; }
place piano_solo_a2 { pattern = &comp_solo_a; track = &piano_notes; at = 176q; harmony = &a2_chords; voicings = &piano_voicings; groove = &swing; }
place piano_solo_b { pattern = &comp_b; track = &piano_notes; at = 208q; harmony = &b_chords; voicings = &piano_voicings; groove = &swing; }
place piano_solo_a3 { pattern = &comp_solo_a; track = &piano_notes; at = 240q; harmony = &a_chords; voicings = &piano_voicings; groove = &swing; }
place piano_out_b { pattern = &comp_b; track = &piano_notes; at = 272q; harmony = &b_chords; voicings = &piano_voicings; groove = &swing; }
place piano_out_a3 { pattern = &comp_a; track = &piano_notes; at = 304q; harmony = &a_chords; voicings = &piano_voicings; groove = &swing; }
place piano_tag { pattern = &comp_tag; track = &piano_notes; at = 336q; harmony = &tag_chords; voicings = &piano_voicings; groove = &swing; }
place ride_time { pattern = &ride_bar; track = &ride_notes; at = 0q; count = 87; groove = &ride_swing; }
place crash_head { pattern = &ride_crash; track = &ride_notes; at = 16q; }
place crash_solo { pattern = &ride_crash; track = &ride_notes; at = 144q; }
place crash_out { pattern = &ride_crash; track = &ride_notes; at = 272q; }
place crash_end { pattern = &ride_crash; track = &ride_notes; at = 348q; }
place hats_time { pattern = &hats_bar; track = &kit_notes; at = 0q; count = 87; groove = &ride_swing; }
place kick_time { pattern = &kick_bar; track = &kit_notes; at = 0q; count = 87; }
place kick_last { pattern = &kick_end; track = &kit_notes; at = 348q; }
place snare_1 { pattern = &snare_a; track = &kit_notes; at = 16q; groove = &swing; }
place snare_2 { pattern = &snare_a; track = &kit_notes; at = 48q; groove = &swing; }
place snare_3 { pattern = &snare_b; track = &kit_notes; at = 80q; groove = &swing; }
place snare_4 { pattern = &snare_a; track = &kit_notes; at = 112q; groove = &swing; }
place snare_5 { pattern = &snare_a; track = &kit_notes; at = 144q; groove = &swing; }
place snare_6 { pattern = &snare_a; track = &kit_notes; at = 176q; groove = &swing; }
place snare_7 { pattern = &snare_b; track = &kit_notes; at = 208q; groove = &swing; }
place snare_8 { pattern = &snare_a; track = &kit_notes; at = 240q; groove = &swing; }
place snare_9 { pattern = &snare_a; track = &kit_notes; at = 272q; groove = &swing; }
place snare_10 { pattern = &snare_a; track = &kit_notes; at = 304q; groove = &swing; }

// ---------------------------------------------------------------- mix
node band { type = "core.sum/1"; config = { channels = 2; }; }
connect sax_out { from = &sax:out; to = &band:in; }
connect piano_out { from = &piano:out; to = &band:in; }
connect bass_out { from = &bass:out; to = &band:in; }
connect ride_out { from = &ride:out; to = &band:in; }
connect kit_out { from = &kit:out; to = &band:in; }

// A small room, then a gentle glue and the limiter.
node room { type = "fx.reverb/1"; config = { channels = 2; predelay = 12ms; damping = 0.5; }; params = { mix = 1; decay = 1.4s; }; }
node room_return { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 0.22; }; }
node mix { type = "core.sum/1"; config = { channels = 2; }; }
connect band_dry { from = &band:out; to = &mix:in; }
connect band_room { from = &band:out; to = &room:in; }
connect room_back { from = &room:out; to = &room_return:in; }
connect room_mix { from = &room_return:out; to = &mix:in; }
node glue { type = "fx.compressor/1"; config = { channels = 2; }; params = { threshold = -14dB; ratio = 3/2; knee = 6dB; attack = 20ms; release = 250ms; makeup = 0dB; }; }
node trim { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 1.4; }; }
node master { type = "fx.limiter/1"; config = { channels = 2; }; params = { gain = 0dB; ceiling = -1.1dB; release = 150ms; }; }
connect mix_glue { from = &mix:out; to = &glue:in; }
connect glue_trim { from = &glue:out; to = &trim:in; }
connect trim_master { from = &trim:out; to = &master:in; }

// ---------------------------------------------------------------- delivery
// `maac deliver rain.maac --delivery release --output-dir out --profile song`
asset schema { kind = descriptor; builtin = "maac.production/1"; }
extension deliveries {
  namespace = "maac.production/1"; schema = &schema; render_affecting = true;
  data = { deliveries = { release = {
    rate = 48000Hz; resampler = "maac.src.kaiser/1";
    targets = { master = {
      role = master; output = &master:out; encoding = wav_pcm24le;
      dither = { type = tpdf; seed = 2026; };
      limits = {
        integrated_loudness = { unit = LUFS; min = -18; max = -14; };
        true_peak = { unit = dBTP; max = -1; };
      };
    }; };
  }; }; };
}
