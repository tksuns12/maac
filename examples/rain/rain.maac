maac 1;

// "After the Rain": a medium swing for a jazz quartet, tenor saxophone,
// piano, double bass and drums, in B-flat, 88 bars at 160 bpm (about two
// and a quarter minutes). An AI producer made it in the T7 production trial
// (docs/reports/ai-production-trial-t7.md). It wrote the instruments and the
// mix by hand, and a script of its own wrote the notes, each saxophone note's
// velocity and breath drawn from seeded random rules. The piano and the drum
// kit are std/studio's; the saxophone, the double bass and the ride cymbal
// are built here.
//
//  1-4   intro: piano, bass and drums on a turnaround
//  5-36  the tune, AABA: the saxophone over walking bass and comping
// 37-68  a chorus of saxophone solo
// 69-84  the tune again from its bridge
// 85-88  tag: the turnaround once more, slowing to a held Bbmaj9

project rain {
  score = [0q, 352q]; rate = 48000Hz; tail = 4s;
  tempo = &clock; meter = &metre; output = &master:out;
  requires = ["maac.production/1"];
}
import studio { builtin = "std/studio/1.2.0"; }
// 160 bpm; the last two bars slow to 112.
tempo clock { points = [(0q, 160bpm, step), (344q, 160bpm, linear), (352q, 112bpm, step)]; }
meter metre { points = [(0q, 4, 4)]; }
region intro { span = [bar(1, 1), bar(5, 1)]; }
region head { span = [bar(5, 1), bar(37, 1)]; }
region solo { span = [bar(37, 1), bar(69, 1)]; }
region head_out { span = [bar(69, 1), bar(85, 1)]; }
region ending { span = [bar(85, 1), bar(89, 1)]; }
// The horns and the piano swing their eighths 3:2; the ride's skip note
// sits on the triplet.
groove swing { grid = 1/2q; ratio = 3/5; }
groove ride_swing { grid = 1/2q; ratio = 2/3; }

// ---------------------------------------------------------------- instruments
// A tenor saxophone: a saw and a sine from the reed and the bore, a lip dip
// of 17 cents into each note, a key-tracked low-pass that velocity and
// pressure open, a drive for the reed's buzz, two body formants near 500 Hz
// and 1.6 kHz, and breath through a band above the pitch. Each note starts
// with the tongue: a quick 6 ms attack, a short "t" of noise, and a tone that
// opens from dark over 60 ms. After it the level holds, with no sag of its
// own: the score's pressure, note by note, is the breath, as are the vibrato,
// scoops and falls. The sine starts at phase 0, opposite the saw's
// fundamental, so it thins the fundamental instead of adding to it (the T7
// report's F63); this is the sound the owner heard.
instrument tenor_sax {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &dynamics:out;
    node amp { type = "synth.adsr/1"; params = { attack = 6ms; sustain = 1; release = 70ms; curve = 2; }; }
    node vel { type = "synth.velocity/1"; }
    node touch { type = "synth.pressure/1"; }
    node scoop { type = "synth.adsr/1"; params = { decay = 35ms; sustain = 0; curve = 3; }; }
    node reed { type = "synth.saw/1"; params = { level = 0.5; }; }
    node bore { type = "synth.sine/1"; params = { level = 0.3; }; }
    modulate scoop_reed { from = &scoop:out; to = &reed.params.ratio; depth = -0.01; }
    modulate scoop_bore { from = &scoop:out; to = &bore.params.ratio; depth = -0.01; }
    node blend { type = "synth.mix/1"; config = { channels = 1; }; }
    connect reed_blend { from = &reed:out; to = &blend:in; }
    connect bore_blend { from = &bore:out; to = &blend:in; }
    node tone { type = "synth.svf/1"; config = { channels = 1; mode = lowpass; }; params = { cutoff = 300Hz; ratio = 2; q = 0.9; }; }
    modulate harder_brighter { from = &vel:out; to = &tone.params.cutoff; depth = 2400Hz; }
    modulate pressed_brighter { from = &touch:out; to = &tone.params.cutoff; depth = 600Hz; }
    connect blend_tone { from = &blend:out; to = &tone:in; }
    node buzz { type = "synth.drive/1"; config = { channels = 1; }; params = { drive = 2; level = 0.6; reference = 1; }; }
    connect tone_buzz { from = &tone:out; to = &buzz:in; }
    node f1 { type = "synth.svf/1"; config = { channels = 1; mode = bandpass; }; params = { cutoff = 520Hz; q = 2.5; }; }
    node f2 { type = "synth.svf/1"; config = { channels = 1; mode = bandpass; }; params = { cutoff = 1650Hz; q = 3; }; }
    connect buzz_f1 { from = &buzz:out; to = &f1:in; }
    connect buzz_f2 { from = &buzz:out; to = &f2:in; }
    node tongue { type = "synth.noise/1"; config = { seed = 3432918353; }; params = { level = 0; }; }
    node tongue_env { type = "synth.adsr/1"; params = { attack = 0ms; decay = 20ms; sustain = 0; curve = 3; }; }
    modulate tongue_shape { from = &tongue_env:out; to = &tongue.params.level; depth = 1.8; }
    node tongue_band { type = "synth.svf/1"; config = { channels = 1; mode = bandpass; }; params = { cutoff = 2500Hz; q = 1.2; }; }
    connect tongue_in { from = &tongue:out; to = &tongue_band:in; }
    node bloom { type = "synth.adsr/1"; params = { attack = 0ms; decay = 60ms; sustain = 0; curve = 2; }; }
    modulate dark_start { from = &bloom:out; to = &tone.params.cutoff; depth = -1200Hz; }
    node breath { type = "synth.noise/1"; config = { seed = 2654435761; }; params = { level = 0.05; }; }
    node breath_band { type = "synth.svf/1"; config = { channels = 1; mode = bandpass; }; params = { cutoff = 800Hz; ratio = 3; q = 1.5; }; }
    connect breath_in { from = &breath:out; to = &breath_band:in; }
    node body { type = "synth.mix/1"; config = { channels = 1; }; }
    connect buzz_body { from = &buzz:out; to = &body:in; }
    connect f1_body { from = &f1:out; to = &body:in; }
    connect f2_body { from = &f2:out; to = &body:in; }
    connect breath_body { from = &breath_band:out; to = &body:in; }
    connect tongue_body { from = &tongue_band:out; to = &body:in; }
    node dynamics { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.6; }; }
    modulate pressed_louder { from = &touch:out; to = &dynamics.params.level; depth = 0.8; }
    connect body_dynamics { from = &body:out; to = &dynamics:in; }
  }
  shared stage {
    channels = 2;
    output = &place:out;
    node low_cut { type = "synth.highpass/1"; config = { channels = 1; }; params = { cutoff = 70Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 24/25; }; }
    node place { type = "synth.pan/1"; params = { pan = 0; }; }
    connect input_cut { from = &input:out; to = &low_cut:in; }
    connect cut_gain { from = &low_cut:out; to = &gain:in; }
    connect gain_place { from = &gain:out; to = &place:in; }
  }
  control level { target = &stage.gain.params.level; default = 24/25; }
  control brightness { target = &voice.tone.params.cutoff; default = 300Hz; }
  control attack { target = &voice.amp.params.attack; default = 6ms; }
  control release { target = &voice.amp.params.release; default = 70ms; }
  control pan { target = &stage.place.params.pan; default = 0; }
}

// A double bass played pizzicato: a fingertip pulse into twenty string modes
// plucked a fifth of the way along, high modes dying first, a low thump from
// the body and a little finger noise. A note's end damps the string.
instrument upright_bass {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &blend:out;
    node amp { type = "synth.adsr/1"; params = { sustain = 1; release = 90ms; curve = 2; }; }
    node vel { type = "synth.velocity/1"; }
    node key { type = "synth.key/1"; }
    node finger { type = "synth.adsr/1"; params = { attack = 0ms; decay = 3ms; sustain = 0; curve = 2; }; }
    node pad { type = "synth.onepole/1"; config = { channels = 1; }; params = { cutoff = 500Hz; }; }
    modulate harder_brighter { from = &vel:out; to = &pad.params.cutoff; depth = 900Hz; }
    connect finger_pad { from = &finger:out; to = &pad:in; }
    node string {
      type = "synth.modal/1";
      config = { modes = 20; };
      params = { decay = 2.4s; damping = 0.9; position = 0.2; stretch = 1/10000; level = 1/100; };
    }
    modulate higher_shorter { from = &key:out; to = &string.params.decay; depth = -500ms; }
    connect pad_string { from = &pad:out; to = &string:in; }
    node thump { type = "synth.sine/1"; params = { ratio = 1; level = 0; }; }
    node thump_env { type = "synth.adsr/1"; params = { decay = 60ms; sustain = 0; curve = 3; }; }
    modulate thump_shape { from = &thump_env:out; to = &thump.params.level; depth = 0.08; }
    node finger_noise { type = "synth.noise/1"; config = { seed = 2246822519; }; params = { level = 0; }; }
    node noise_env { type = "synth.adsr/1"; params = { decay = 10ms; sustain = 0; curve = 4; }; }
    modulate noise_shape { from = &noise_env:out; to = &finger_noise.params.level; depth = 0.03; }
    node noise_band { type = "synth.svf/1"; config = { channels = 1; mode = bandpass; }; params = { cutoff = 0Hz; ratio = 6; q = 1; }; }
    connect noise_in { from = &finger_noise:out; to = &noise_band:in; }
    node blend { type = "synth.mix/1"; config = { channels = 1; }; }
    connect string_blend { from = &string:out; to = &blend:in; }
    connect thump_blend { from = &thump:out; to = &blend:in; }
    connect noise_blend { from = &noise_band:out; to = &blend:in; }
  }
  shared stage {
    channels = 2;
    output = &place:out;
    node low_cut { type = "synth.highpass/1"; config = { channels = 1; }; params = { cutoff = 35Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 4/5; }; }
    node place { type = "synth.pan/1"; params = { pan = 0.1; }; }
    connect input_cut { from = &input:out; to = &low_cut:in; }
    connect cut_gain { from = &low_cut:out; to = &gain:in; }
    connect gain_place { from = &gain:out; to = &place:in; }
  }
  control level { target = &stage.gain.params.level; default = 4/5; }
  control release { target = &voice.amp.params.release; default = 90ms; }
  control pan { target = &stage.place.params.pan; default = 0.1; }
}

// A ride cymbal: the stick's tick, a bright ping from six banks of
// inharmonic modes spread from 2 kHz up, no one of them a pitch, and a wash
// of noise in two bands that rings for seconds, the top band dying first.
// Harder strokes bring more wash and a brighter top. Each stroke is a voice
// of its own.
instrument ride_cymbal {
  channels = 2;
  voice voice {
    channels = 2;
    amplitude = &amp;
    output = &cymbal:out;
    node amp { type = "synth.adsr/1"; params = { attack = 0ms; decay = 6s; sustain = 0; release = 3s; curve = 4; }; }
    node vel { type = "synth.velocity/1"; }
    node stick { type = "synth.adsr/1"; params = { attack = 0ms; decay = 0.4ms; sustain = 0; curve = 2; }; }
    node ping_1 { type = "synth.modal/1"; config = { modes = 8; }; params = { ratio = 1.41; stretch = 1/24; decay = 1.8s; damping = 0.4; position = 0.13; level = 1/60; }; }
    connect stick_1 { from = &stick:out; to = &ping_1:in; }
    node ping_2 { type = "synth.modal/1"; config = { modes = 8; }; params = { ratio = 1.67; stretch = 1/34; decay = 1.6s; damping = 0.45; position = 0.21; level = 1/64; }; }
    connect stick_2 { from = &stick:out; to = &ping_2:in; }
    node ping_3 { type = "synth.modal/1"; config = { modes = 8; }; params = { ratio = 1.94; stretch = 1/27; decay = 1.5s; damping = 0.45; position = 0.17; level = 1/68; }; }
    connect stick_3 { from = &stick:out; to = &ping_3:in; }
    node ping_4 { type = "synth.modal/1"; config = { modes = 8; }; params = { ratio = 2.29; stretch = 1/31; decay = 1.3s; damping = 0.5; position = 0.27; level = 1/72; }; }
    connect stick_4 { from = &stick:out; to = &ping_4:in; }
    node ping_5 { type = "synth.modal/1"; config = { modes = 8; }; params = { ratio = 2.71; stretch = 1/22; decay = 1.2s; damping = 0.5; position = 0.11; level = 1/76; }; }
    connect stick_5 { from = &stick:out; to = &ping_5:in; }
    node ping_6 { type = "synth.modal/1"; config = { modes = 8; }; params = { ratio = 3.13; stretch = 1/28; decay = 1.0s; damping = 0.55; position = 0.23; level = 1/80; }; }
    connect stick_6 { from = &stick:out; to = &ping_6:in; }
    node ping { type = "synth.mix/1"; config = { channels = 1; }; }
    connect ping_1_mix { from = &ping_1:out; to = &ping:in; }
    connect ping_2_mix { from = &ping_2:out; to = &ping:in; }
    connect ping_3_mix { from = &ping_3:out; to = &ping:in; }
    connect ping_4_mix { from = &ping_4:out; to = &ping:in; }
    connect ping_5_mix { from = &ping_5:out; to = &ping:in; }
    connect ping_6_mix { from = &ping_6:out; to = &ping:in; }
    node ping_place { type = "synth.pan/1"; params = { pan = 0.3; }; }
    connect ping_pan { from = &ping:out; to = &ping_place:in; }
    node tick { type = "synth.noise/1"; config = { seed = 3266489917; }; params = { level = 0; }; }
    node tick_env { type = "synth.adsr/1"; params = { decay = 4ms; sustain = 0; curve = 4; }; }
    modulate tick_shape { from = &tick_env:out; to = &tick.params.level; depth = 0.35; }
    node tick_top { type = "synth.highpass/1"; config = { channels = 1; }; params = { cutoff = 5000Hz; }; }
    connect tick_in { from = &tick:out; to = &tick_top:in; }
    node tick_place { type = "synth.pan/1"; params = { pan = 0.3; }; }
    connect tick_pan { from = &tick_top:out; to = &tick_place:in; }
    node wash_l { type = "synth.noise/1"; config = { seed = 668265263; }; params = { level = 0.05; }; }
    node wash_r { type = "synth.noise/1"; config = { seed = 374761393; }; params = { level = 0.05; }; }
    modulate harder_l { from = &vel:out; to = &wash_l.params.level; depth = 0.06; }
    modulate harder_r { from = &vel:out; to = &wash_r.params.level; depth = 0.06; }
    node left { type = "synth.pan/1"; params = { pan = 0.05; }; }
    node right { type = "synth.pan/1"; params = { pan = 0.6; }; }
    connect l_pan { from = &wash_l:out; to = &left:in; }
    connect r_pan { from = &wash_r:out; to = &right:in; }
    node wash { type = "synth.mix/1"; config = { channels = 2; }; }
    connect left_wash { from = &left:out; to = &wash:in; }
    connect right_wash { from = &right:out; to = &wash:in; }
    node body { type = "synth.svf/1"; config = { channels = 2; mode = bandpass; }; params = { cutoff = 4200Hz; q = 0.7; }; }
    node shimmer { type = "synth.svf/1"; config = { channels = 2; mode = bandpass; }; params = { cutoff = 9000Hz; q = 0.9; }; }
    modulate harder_brighter { from = &vel:out; to = &shimmer.params.cutoff; depth = 2500Hz; }
    connect wash_body { from = &wash:out; to = &body:in; }
    connect wash_shimmer { from = &wash:out; to = &shimmer:in; }
    node shimmer_env { type = "synth.adsr/1"; params = { attack = 8ms; decay = 1500ms; sustain = 0.15; curve = 3; }; }
    node shimmer_gain { type = "synth.gain/1"; config = { channels = 2; }; params = { level = 0; }; }
    modulate shimmer_fade { from = &shimmer_env:out; to = &shimmer_gain.params.level; depth = 0.8; }
    connect shimmer_in { from = &shimmer:out; to = &shimmer_gain:in; }
    node cymbal { type = "synth.mix/1"; config = { channels = 2; }; }
    connect ping_cymbal { from = &ping_place:out; to = &cymbal:in; }
    connect tick_cymbal { from = &tick_place:out; to = &cymbal:in; }
    connect body_cymbal { from = &body:out; to = &cymbal:in; }
    connect shimmer_cymbal { from = &shimmer_gain:out; to = &cymbal:in; }
  }
  shared stage {
    channels = 2;
    output = &gain:out;
    node low_cut { type = "synth.highpass/1"; config = { channels = 2; }; params = { cutoff = 400Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 2; }; params = { level = 81/50; }; }
    connect input_cut { from = &input:out; to = &low_cut:in; }
    connect cut_gain { from = &low_cut:out; to = &gain:in; }
  }
  control level { target = &stage.gain.params.level; default = 81/50; }
  control decay { target = &voice.amp.params.decay; default = 6s; }
}

// ---------------------------------------------------------------- harmony
// The changes, a chord per bar or per half bar. Chord names are labels: the
// piano's voicings spell each one, and the bass lines are written out.
harmony intro_chords { length = 16q; chords = [(0q, "Cm7"), (2q, "F7"), (4q, "Dm7"), (6q, "G7b9"), (8q, "Cm7"), (10q, "F7"), (12q, "Cm7"), (14q, "F7")]; }
harmony a_chords { length = 32q; chords = [(0q, "Bbmaj7"), (4q, "G7b9"), (8q, "Cm7"), (12q, "F7"), (16q, "Dm7"), (18q, "G7b9"), (20q, "Cm7"), (22q, "F7"), (24q, "Bbmaj7"), (26q, "G7b9"), (28q, "Cm7"), (30q, "F7")]; }
harmony a2_chords { length = 32q; chords = [(0q, "Bbmaj7"), (4q, "G7b9"), (8q, "Cm7"), (12q, "F7"), (16q, "Dm7"), (18q, "G7b9"), (20q, "Cm7"), (22q, "F7"), (24q, "Bbmaj7"), (28q, "Fm7"), (30q, "Bb7")]; }
harmony b_chords { length = 32q; chords = [(0q, "Ebmaj7"), (8q, "Ebm7"), (12q, "Ab7"), (16q, "Dm7"), (20q, "G7b9"), (24q, "Cm7"), (28q, "F7")]; }
harmony tag_chords { length = 16q; chords = [(0q, "Cm7"), (2q, "F7"), (4q, "Dm7"), (6q, "G7b9"), (8q, "Cm7"), (10q, "F7"), (12q, "Bbmaj9")]; }

// The piano's left hand: rootless voicings, the bass has the roots.
voicing p_bbmaj7 { pitches = [D3, F3, A3, C4]; }
voicing p_bbmaj9 { pitches = [D3, F3, A3, C4, F4]; }
voicing p_g7b9 { pitches = [F3, Ab3, B3, E4]; }
voicing p_cm7 { pitches = [Eb3, G3, Bb3, D4]; }
voicing p_f7 { pitches = [Eb3, G3, A3, D4]; }
voicing p_dm7 { pitches = [F3, A3, C4, E4]; }
voicing p_ebmaj7 { pitches = [G3, Bb3, D4, F4]; }
voicing p_ebm7 { pitches = [Gb3, Bb3, Db4, F4]; }
voicing p_ab7 { pitches = [Gb3, Bb3, C4, F4]; }
voicing p_fm7 { pitches = [Ab3, C4, Eb4, G4]; }
voicing p_bb7 { pitches = [Ab3, C4, D4, G4]; }
voicings piano_voicings { chords = [("Bbmaj7", &p_bbmaj7), ("Bbmaj9", &p_bbmaj9), ("G7b9", &p_g7b9), ("Cm7", &p_cm7), ("F7", &p_f7), ("Dm7", &p_dm7), ("Ebmaj7", &p_ebmaj7), ("Ebm7", &p_ebm7), ("Ab7", &p_ab7), ("Fm7", &p_fm7), ("Bb7", &p_bb7)]; }

// The saxophone's colours: a vibrato on held notes, a scoop into a few, and
// a fall off the ends of phrases.
vibrato sax_vib { rate = 26/5Hz; depth = 16ct; delay = 250ms; rise = 300ms; }
curve scoop { clock = seconds; points = [(0ms, -120ct, linear), (90ms, 0ct, step)]; }
curve fall { clock = normalized; points = [(0, 0ct, step), (1/2, 0ct, linear), (1, -500ct, step)]; }

// ---------------------------------------------------------------- the saxophone

// The tune's A: up the Bbmaj7, the b9 of G7 falling to its third.
pattern head_a { length = 32q;
  note s1 { at = 1/2q; dur = 1/2q; pitch = D3; velocity = 0.57; onset_offset = 18ms; release_offset = 18ms; expression scoop { kind = pitch; curve = &scoop; } expression breath { kind = pressure; curve = &br_head_a_1; } }
  note s2 { at = 1q; dur = 1/2q; pitch = F3; velocity = 0.55; onset_offset = 18ms; release_offset = 18ms; expression scoop { kind = pitch; curve = &scoop; } expression breath { kind = pressure; curve = &br_head_a_2; } }
  note s3 { at = 3/2q; dur = 1/2q; pitch = A3; velocity = 0.66; onset_offset = 18ms; release_offset = 18ms; expression scoop { kind = pitch; curve = &scoop; } expression breath { kind = pressure; curve = &br_head_a_3; } }
  note s4 { at = 2q; dur = 3/2q; pitch = C4; velocity = 0.75; onset_offset = 18ms; release_offset = 18ms; expression scoop { kind = pitch; curve = &scoop; } expression breath { kind = pressure; curve = &br_head_a_4; } }
  note s5 { at = 7/2q; dur = 1/2q; pitch = Bb3; velocity = 0.59; onset_offset = 18ms; release_offset = 18ms; expression scoop { kind = pitch; curve = &scoop; } expression breath { kind = pressure; curve = &br_head_a_5; } }
  note s6 { at = 4q; dur = 3/2q; pitch = Ab3; velocity = 0.66; onset_offset = 18ms; release_offset = 18ms; expression scoop { kind = pitch; curve = &scoop; } expression breath { kind = pressure; curve = &br_head_a_6; } }
  note s7 { at = 11/2q; dur = 1/2q; pitch = G3; velocity = 0.58; onset_offset = 18ms; release_offset = 18ms; expression scoop { kind = pitch; curve = &scoop; } expression breath { kind = pressure; curve = &br_head_a_7; } }
  note s8 { at = 6q; dur = 1/2q; pitch = F3; velocity = 0.58; onset_offset = 18ms; release_offset = 18ms; expression scoop { kind = pitch; curve = &scoop; } expression breath { kind = pressure; curve = &br_head_a_8; } }
  note s9 { at = 13/2q; dur = 1/2q; pitch = D3; velocity = 0.64; onset_offset = 18ms; release_offset = 18ms; expression scoop { kind = pitch; curve = &scoop; } expression breath { kind = pressure; curve = &br_head_a_9; } }
  note s10 { at = 7q; dur = 3/5q; pitch = B2; velocity = 0.58; onset_offset = 18ms; release_offset = 18ms; expression breath { kind = pressure; curve = &br_head_a_10; } }
  note s11 { at = 17/2q; dur = 1/2q; pitch = Eb3; velocity = 0.57; onset_offset = 18ms; release_offset = 18ms; expression scoop { kind = pitch; curve = &scoop; } expression breath { kind = pressure; curve = &br_head_a_11; } }
  note s12 { at = 9q; dur = 1/2q; pitch = G3; velocity = 0.56; onset_offset = 18ms; release_offset = 18ms; expression scoop { kind = pitch; curve = &scoop; } expression breath { kind = pressure; curve = &br_head_a_12; } }
