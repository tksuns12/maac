maac 1;

// Per-note pressure and timbre choose the onset phase of a voice oscillator
// and its LFO.  Their later curve changes do not retune the captured phases.
project internal_phase_demo {
  score = [0q, 2q];
  tail = 40ms;
  rate = 48000Hz;
  tempo = &clock;
  meter = &metre;
  output = &sound:out;
}
tempo clock { points = [(0q, 120bpm, step)]; }
meter metre { points = [(0q, 4, 4)]; }

instrument phase_voice {
  channels = 1;
  voice v {
    channels = 1;
    amplitude = &amp;
    output = &mix:out;
    node amp {
      type = "synth.adsr/1";
      params = { attack = 10ms; decay = 15ms; sustain = 3/4; release = 30ms; };
    }
    node osc {
      type = "synth.sine/1";
      params = { ratio = 1; phase = 1/8; level = 1/8; };
    }
    node lfo {
      type = "synth.lfo/1";
      params = { frequency = 2Hz; phase = 1/8; level = 1/16; };
    }
    node pressure { type = "synth.pressure/1"; }
    node timbre { type = "synth.timbre/1"; }
    node mix {
      type = "synth.mix/1";
      config = { channels = 1; };
    }
    connect oscillator_mix { from = &osc:out; to = &mix:in; }
    connect lfo_mix { from = &lfo:out; to = &mix:in; }
    modulate pressure_phase {
      from = &pressure:out;
      to = &osc.params.phase;
      depth = 1/4;
    }
    modulate timbre_lfo_phase {
      from = &timbre:out;
      to = &lfo.params.phase;
      depth = 1/2;
    }
  }
}
node sound { instrument = &phase_voice; config = { voices = 3; }; }

curve pressure_low {
  clock = normalized;
  points = [(0, 1/4, step), (1/3, 3/4, linear), (1, 1/2, step)];
}
curve pressure_high {
  clock = normalized;
  points = [(0, 3/4, step), (1/3, 1/4, linear), (1, 1/2, step)];
}
curve pressure_mid {
  clock = normalized;
  points = [(0, 1/2, step), (1/3, 1/4, linear), (1, 3/4, step)];
}
curve timbre_low {
  clock = normalized;
  points = [(0, 1/4, step), (1/2, 3/4, linear), (1, 1/2, step)];
}
curve timbre_high {
  clock = normalized;
  points = [(0, 3/4, step), (1/2, 1/4, linear), (1, 1/2, step)];
}
curve timbre_mid {
  clock = normalized;
  points = [(0, 1/2, step), (1/2, 1/4, linear), (1, 3/4, step)];
}

pattern phrase {
  length = 2q;
  note first {
    at = 0q;
    dur = 3/8q;
    pitch = C4;
    velocity = 1/2;
    expression touch { kind = pressure; curve = &pressure_low; }
    expression color { kind = timbre; curve = &timbre_low; }
  }
  note second {
    at = 1/2q;
    dur = 3/8q;
    pitch = E4;
    velocity = 1/2;
    expression touch { kind = pressure; curve = &pressure_high; }
    expression color { kind = timbre; curve = &timbre_high; }
  }
  note third {
    at = 1q;
    dur = 3/8q;
    pitch = G4;
    velocity = 1/2;
    expression touch { kind = pressure; curve = &pressure_mid; }
    expression color { kind = timbre; curve = &timbre_mid; }
  }
}
track notes { target = &sound:events; }
place once { pattern = &phrase; track = &notes; at = 0q; }
