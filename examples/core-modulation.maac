maac 1;

// Reuse the original synthesized PCM from the core-kit example.
// Run from the repository root:
// maac build examples/core-modulation.maac --project-root . -o core-modulation.wav
project demo {
  score = [0q, 4q];
  tail = 1/2s;
  rate = 48000Hz;
  tempo = &clock;
  meter = &metre;
  output = &stereo:out;
  requires = ["maac.production/1"];
}
tempo clock { points = [(0q, 120bpm, linear), (2q, 150bpm, linear), (4q, 120bpm, step), (17/4q, 100bpm, step)]; }
meter metre { points = [(0q, 4, 4)]; }

asset kick_sample {
  kind = audio;
  path = "examples/sounds/core-kit/kick.pcm";
  hash = "sha256:b29ea5c52a79d974b5d897530609d0d06a7d6cd315ae2d774340a8322c887b04";
  format = "pcm_f32le_interleaved/1";
  rate = 24000Hz; channels = 1; frames = 4800;
}

// This targetless track groups clips; tracks add no gain or routing.
track arranged {}
audio forward {
  asset = &kick_sample;
  at = 0q;
  source = [0frame, 4800frame];
  mode = rate;
  gain = 1/2;
  fade_in = 1ms; fade_out = 20ms;
  track = &arranged;
}
// These anchors align the slice to half a score beat.
// Tempo ramps change its physical playback rate and pitch.
audio shaped {
  asset = &kick_sample;
  at = 1q;
  source = [0frame, 4800frame];
  mode = warp_rate;
  warp = [(0q, 0frame), (1/4q, 2400frame), (1/2q, 4800frame)];
  gain = 1/2;
  fade_in = 1ms; fade_out = 30ms;
  fade_shape = equal_power;
  track = &arranged;
}
// This pre-score-end transport continues into the declared physical tail,
// crossing the tempo change at 17/4q after score end (4q).
audio tail_slice {
  asset = &kick_sample;
  at = 15/4q;
  source = [240frame, 3600frame];
  mode = warp_rate;
  warp = [(0q, 240frame), (1/4q, 1200frame), (3/4q, 3600frame)];
  gain = 1/3;
  fade_in = 5ms; fade_out = 40ms;
  track = &arranged;
}

// A native hit and a pitched note join the clips in the same explicit graph.
node kit {
  type = "core.kit/1";
  config = {
    channels = 1; voices = 2;
    samples = [{ key = "kick"; asset = &kick_sample; }];
  };
  params = { level = 1/3; };
}
track drums { target = &kit:events; }
pattern pulse {
  length = 4q;
  hit beat { at = 2q; key = "kick"; velocity = 3/4; }
}
place pulses { pattern = &pulse; track = &drums; at = 0q; count = 1; }
node tone {
  type = "core.sine/1";
  params = { attack = 10ms; release = 50ms; level = 1/10; };
}
track melody { target = &tone:events; }
pattern phrase {
  length = 4q;
  note last { at = 3q; dur = 1q; pitch = key(57); velocity = 1/2; }
}
place ending { pattern = &phrase; track = &melody; at = 0q; }

node mix { type = "core.sum/1"; config = { channels = 1; }; }
node room { type = "fx.reverb/1"; config = { channels = 1; }; params = { mix = 1/10; }; }
node master { type = "core.gain/1"; config = { channels = 1; }; params = { gain = 3/4; }; }
connect forward_route { from = &forward:out; to = &mix:in; }
connect shaped_route { from = &shaped:out; to = &mix:in; }
connect tail_route { from = &tail_slice:out; to = &mix:in; }
connect kit_route { from = &kit:out; to = &mix:in; }
connect tone_route { from = &tone:out; to = &mix:in; }
connect room_route { from = &filter:out; to = &room:in; }
connect master_route { from = &room:out; to = &master:in; }

// Score motion follows the tempo ramps and holds at score end during the tail.
node score_motion { type = "core.lfo/1"; config = { period = 2q; wave = triangle; }; }
// Physical motion keeps moving through the half-second tail.
node physical_motion { type = "core.lfo/1"; config = { period = 3/4s; }; }
node depth { type = "core.constant/1"; }
curve depth_shape { clock = score; points = [(0q, 0, linear), (4q, 1/2, step)]; }
automation depth_lane { target = &depth.params.value; curve = &depth_shape; at = 0q; }
modulate depth_motion { from = &score_motion:out; target = &depth.params.value; amount = 1/4; }
modulate gain_motion { from = &depth:out; target = &master.params.gain; amount = 1/4; }
node stereo { type = "core.pan/1"; }
connect stereo_route { from = &master:out; to = &stereo:in; }
modulate pan_motion { from = &physical_motion:out; target = &stereo.params.pan; amount = 1/2; }

node filter { type = "core.onepole/1"; config = { channels = 1; }; params = { cutoff = 3000Hz; }; }
connect filter_route { from = &mix:out; to = &filter:in; }
modulate cutoff_motion { from = &score_motion:out; target = &filter.params.cutoff; amount = 1800Hz; }
