maac 1;

// A frame-zero constant automation and a physical LFO drive a public
// shared-LFO phase control at reset. The shared graph also has its own
// reset-phase edge; source_level remains an authored sample-rate control for
// that internal capture.
project reset_rate_demo {
  score = [0q, 2q];
  tail = 40ms;
  rate = 48000Hz;
  tempo = &clock;
  meter = &metre;
  output = &voice:out;
}
tempo clock { points = [(0q, 120bpm, step)]; }
meter metre { points = [(0q, 4, 4)]; }

instrument reset_rate_voice {
  channels = 1;
  voice v {
    channels = 1;
    amplitude = &amp;
    output = &carrier:out;
    node amp {
      type = "synth.adsr/1";
      params = { attack = 8ms; decay = 12ms; sustain = 3/4; release = 30ms; };
    }
    node carrier {
      type = "synth.sine/1";
      params = { ratio = 1; level = 1/8; };
    }
  }
  shared fx {
    channels = 1;
    output = &mix:out;
    node source {
      type = "synth.lfo/1";
      params = { frequency = 1Hz; phase = 1/4; level = 1/4; };
    }
    node target {
      type = "synth.lfo/1";
      params = { frequency = 2Hz; phase = 0; level = 1/4; };
    }
    node mix {
      type = "synth.mix/1";
      config = { channels = 1; };
    }
    connect target_mix { from = &target:out; to = &mix:in; }
    connect input_mix { from = &input:out; to = &mix:in; }
    modulate internal_phase {
      from = &source:out;
      to = &target.params.phase;
      depth = 1/8;
    }
  }
  control shared_phase { target = &fx.target.params.phase; default = 0; }
  control source_level { target = &fx.source.params.level; default = 1/4; }
}

node voice {
  instrument = &reset_rate_voice;
  config = { voices = 2; };
  params = { shared_phase = 0; source_level = 1/4; };
}

// This source graph is evaluated at frame zero before the instrument's
// shared reset state is constructed. Its authored value is retained for the
// normal pass, while the captured reset phase uses the frame-zero value.
node phase_source { type = "core.constant/1"; params = { value = 0; }; }
node phase_motion {
  type = "core.lfo/1";
  config = { period = 1/2s; wave = sine; phase = 1/4; };
}
curve frame_zero_phase {
  clock = score;
  points = [(0q, 1/4, step), (2q, 1/4, step)];
}
automation phase_at_origin {
  target = &phase_source.params.value;
  curve = &frame_zero_phase;
  at = 0q;
}
modulate constant_phase {
  from = &phase_source:out;
  target = &voice.params.shared_phase;
  amount = 1;
}
modulate moving_phase {
  from = &phase_motion:out;
  target = &voice.params.shared_phase;
  amount = 1/4;
}

pattern phrase {
  length = 2q;
  note first { at = 0q; dur = 1/2q; pitch = C4; velocity = 1/2; }
  note second { at = 1/2q; dur = 1/2q; pitch = E4; velocity = 1/2; }
  note third { at = 1q; dur = 3/4q; pitch = G4; velocity = 1/2; }
}
track notes { target = &voice:events; }
place play { pattern = &phrase; track = &notes; at = 0q; }
