maac 1;

// The same chord at four strengths, then a phrase with varied velocity:
// harder notes bark and brighten; higher notes decay sooner.
project electric_piano_audition {
  score = [0q, 16q]; rate = 48000Hz;
  tempo = &clock; meter = &metre; output = &sound:out; tail = 1500ms;
}
tempo clock { points = [(0q, 90bpm, step)]; }
meter metre { points = [(0q, 4, 4)]; }
import studio { builtin = "std/studio/1.0.0"; }
node sound { instrument = &studio.electric_piano; config = { voices = 24; }; }
pattern phrase {
  length = 16q;
  chord soft { at = 0q; dur = 3/2q; pitches = [F3, A3, C4, E4]; velocity = 0.25; }
  chord medium { at = 2q; dur = 3/2q; pitches = [F3, A3, C4, E4]; velocity = 0.5; }
  chord firm { at = 4q; dur = 3/2q; pitches = [F3, A3, C4, E4]; velocity = 0.75; }
  chord hard { at = 6q; dur = 3/2q; pitches = [F3, A3, C4, E4]; velocity = 1; }
  note m1 { at = 8q; dur = 1/2q; pitch = C5; velocity = 0.45; }
  note m2 { at = 17/2q; dur = 1/2q; pitch = E5; velocity = 0.6; }
  note m3 { at = 9q; dur = 1q; pitch = G5; velocity = 0.8; }
  note m4 { at = 10q; dur = 1/2q; pitch = E5; velocity = 0.5; }
  note m5 { at = 21/2q; dur = 3/2q; pitch = D5; velocity = 0.65; }
  chord close { at = 12q; dur = 4q; pitches = [C2, G3, B3, E4]; velocity = [0.7, 0.5, 0.45, 0.45]; }
}
track notes { target = &sound:events; }
place once { pattern = &phrase; track = &notes; at = 0q; }
