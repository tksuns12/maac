maac 1;

// Long overlapping gates let the slow synthesized pad attack develop.
// Discover defaults and controls with: maac instruments warm_pad
project warm_pad_audition {
  score = [0q, 4q];
  rate = 48000Hz;
  tempo = &clock;
  meter = &metre;
  output = &sound:out;
  tail = 1800ms;
}
tempo clock { points = [(0q, 120bpm, step)]; }
meter metre { points = [(0q, 4, 4)]; }

import basic { builtin = "std/basic/1.0.0"; }
node sound { instrument = &basic.warm_pad; config = { voices = 4; }; }

pattern phrase {
  length = 4q;
  note n0 { at = 0q; dur = 7/2q; pitch = C4; velocity = 0.5; }
  note n1 { at = 1q; dur = 3q; pitch = E4; velocity = 0.4; }
  note n2 { at = 1q; dur = 3q; pitch = G4; velocity = 0.35; }
}
track notes { target = &sound:events; }
place once { pattern = &phrase; track = &notes; at = 0q; }
