maac 1;

// Feature showcase, generated by generate.py (edit showcase.maac.in instead).
// Run from the repository root:
// maac build examples/showcase/showcase.maac --project-root . -o showcase.wav
//
//  0-16q  Pitched sampler: one C4 sample played across two octaves, then a
//         held chord that sustains on the sample's forward loop.
// 16-32q  Velocity layers: C4/G4 at velocity 1/16 .. 1 crossfade from a
//         mellow layer to a bright one between 2/5 and 3/5.
// 32-48q  Key crossfade: a C3..C6 scale crossfades a bowed low sample into a
//         glass bell over F#4..C5 (equal power); then F#4 alone, then C3 + C6.
// 48-52q  The recorded phrase at its own speed (rate).
// 53-61q  warp_rate x2 slower: an octave lower.
// 62-70q  warp_preserve x2 slower: same pitch (core.stretch.ola/1).
// 71-73q  warp_preserve x2 faster: same pitch.
// 74-76q  warp_rate x2 faster: an octave higher.
// 77-79q  Stereo: one stereo recording as an audio clip at its own pitch. Its
//         strike is on the left and its ring lasts on the right.
// 79-92q  The same recording as a pitched sampler (sample { asset = ...; }),
//         then over a stereo pad whose channels are tuned 2.8 Hz apart.
// 93-101q Finale: everything together.
project showcase {
  score = [0q, 101q];
  tail = 2s;
  rate = 48000Hz;
  tempo = &clock;
  meter = &metre;
  output = &master:out;
  requires = ["maac.production/1"];
}
tempo clock { points = [(0q, 100bpm, step)]; }
meter metre { points = [(0q, 4, 4)]; }

// Embedded WAV samples.
sample keys_c4 { path = "keys.wav"; hash = "@KEYS@"; root = C4; loop = [34040frame, 52440frame]; }
sample bowed_c3 { path = "low.wav"; hash = "@LOW@"; root = C3; loop = [36333frame, 47343frame]; }
sample bell_c5 { path = "high.wav"; hash = "@HIGH@"; root = C5; }
// Asset-backed samples (disk-media capable).
sample soft_c4 {
  path = "soft.pcm"; hash = "@SOFT@";
  format = "pcm_f32le_interleaved/1"; rate = 48000Hz; frames = 48000;
  root = C4; loop = [30176frame, 46736frame];
}
sample hard_c4 {
  path = "hard.pcm"; hash = "@HARD@";
  format = "pcm_f32le_interleaved/1"; rate = 48000Hz; frames = 48000;
  root = C4; loop = [30176frame, 46736frame];
}

// Stereo: a WAV pad and a sample that plays a composition audio asset.
sample wide_c4 { path = "wide.wav"; hash = "@WIDE@"; root = C4; loop = [15000frame, 48855frame]; }
asset glass {
  kind = audio; path = "@REL@/glass.pcm"; hash = "@GLASS@";
  format = "pcm_f32le_interleaved/1"; rate = 48000Hz; channels = 2; frames = 57600;
}
sample glass_a4 { asset = &glass; root = A4; }

instrument keys_inst {
  channels = 1;
  voice v {
    channels = 1; amplitude = &amp; output = &play:out;
    node amp { type = "synth.adsr/1"; params = { attack = 2ms; decay = 400ms; sustain = 0.8; release = 500ms; }; }
    node play { type = "synth.sample/1"; config = { zones = [{ sample = &keys_c4; low = key(0); high = key(127); }]; }; params = { level = 0.55; }; }
  }
}

instrument layered_inst {
  channels = 1;
  voice v {
    channels = 1; amplitude = &amp; output = &play:out;
    node amp { type = "synth.adsr/1"; params = { attack = 2ms; decay = 300ms; sustain = 0.8; release = 300ms; }; }
    node play {
      type = "synth.sample/1";
      config = {
        fade_shape = equal_power;
        zones = [
          { sample = &soft_c4; low = key(24); high = key(96); velocity = [0, 3/5]; velocity_fade = [0, 1/5]; },
          { sample = &hard_c4; low = key(24); high = key(96); velocity = [2/5, 1]; velocity_fade = [1/5, 0]; }
        ];
      };
      params = { level = 0.8; };
    }
  }
}

instrument sweep_inst {
  channels = 1;
  voice v {
    channels = 1; amplitude = &amp; output = &play:out;
    node amp { type = "synth.adsr/1"; params = { attack = 5ms; decay = 300ms; sustain = 0.8; release = 400ms; }; }
    node play {
      type = "synth.sample/1";
      config = {
        fade_shape = equal_power;
        zones = [
          { sample = &bowed_c3; low = key(36); high = key(72); key_fade = [0, 12]; },
          { sample = &bell_c5; low = key(61); high = key(96); key_fade = [12, 0]; }
        ];
      };
      params = { level = 0.6; };
    }
  }
}

instrument pad_inst {
  channels = 2;
  voice v {
    channels = 2; amplitude = &amp; output = &play:out;
    node amp { type = "synth.adsr/1"; params = { attack = 120ms; decay = 300ms; sustain = 0.9; release = 700ms; }; }
    node play { type = "synth.sample/1"; config = { channels = 2; zones = [{ sample = &wide_c4; low = key(0); high = key(127); }]; }; params = { level = 0.3; }; }
  }
}

instrument glass_inst {
  channels = 2;
  voice v {
    channels = 2; amplitude = &amp; output = &play:out;
    node amp { type = "synth.adsr/1"; params = { attack = 1ms; decay = 0s; sustain = 1; release = 600ms; }; }
    node play { type = "synth.sample/1"; config = { channels = 2; zones = [{ sample = &glass_a4; low = key(0); high = key(127); }]; }; params = { level = 0.9; }; }
  }
}

node keys { instrument = &keys_inst; }
node layered { instrument = &layered_inst; }
node sweep { instrument = &sweep_inst; }
node pad { instrument = &pad_inst; }
node glass_keys { instrument = &glass_inst; }
track keys_track { target = &keys:events; }
track layered_track { target = &layered:events; }
track sweep_track { target = &sweep:events; }
track pad_track { target = &pad:events; }
track glass_track { target = &glass_keys:events; }

pattern keys_part {
  length = 101q;
@KEYS_NOTES@}
pattern layered_part {
  length = 101q;
@LAYER_NOTES@}
pattern sweep_part {
  length = 101q;
@SWEEP_NOTES@}
pattern pad_part {
  length = 101q;
@PAD_NOTES@}
pattern glass_part {
  length = 101q;
@GLASS_NOTES@}
place keys_play { pattern = &keys_part; track = &keys_track; at = 0q; }
place layered_play { pattern = &layered_part; track = &layered_track; at = 0q; }
place sweep_play { pattern = &sweep_part; track = &sweep_track; at = 0q; }
place pad_play { pattern = &pad_part; track = &pad_track; at = 0q; }
place glass_play { pattern = &glass_part; track = &glass_track; at = 0q; }

// Drums from the core-kit example, in the opening and the finale.
asset kick_sample {
  kind = audio; path = "examples/sounds/core-kit/kick.pcm";
  hash = "sha256:b29ea5c52a79d974b5d897530609d0d06a7d6cd315ae2d774340a8322c887b04";
  format = "pcm_f32le_interleaved/1"; rate = 24000Hz; channels = 1; frames = 4800;
}
asset snare_sample {
  kind = audio; path = "examples/sounds/core-kit/snare.pcm";
  hash = "sha256:dfedbee9ec071476e09e6ea8e54eb7338cac15629b4c26405eb67cff6ce507ca";
  format = "pcm_f32le_interleaved/1"; rate = 24000Hz; channels = 1; frames = 2400;
}
asset hat_sample {
  kind = audio; path = "examples/sounds/core-kit/hat.pcm";
  hash = "sha256:2327a8e3cdfd4c72d8f1e89ea273355ce024f3ea1004985d5f393838e35aadb4";
  format = "pcm_f32le_interleaved/1"; rate = 48000Hz; channels = 1; frames = 1680;
}
node kit {
  type = "core.kit/1";
  config = {
    channels = 1; voices = 6;
    samples = [
      { key = "kick"; asset = &kick_sample; },
      { key = "snare"; asset = &snare_sample; },
      { key = "hat"; asset = &hat_sample; }
    ];
  };
  params = { level = 1/2; };
}
track drums { target = &kit:events; }
pattern groove {
  length = 4q;
  hit kick_one { at = 0q; key = "kick"; velocity = 1; }
  hit kick_two { at = 2q; key = "kick"; velocity = 9/10; }
  hit snare_one { at = 1q; key = "snare"; velocity = 3/5; }
  hit snare_two { at = 3q; key = "snare"; velocity = 3/4; }
  hit hat_one { at = 0q; key = "hat"; velocity = 3/5; }
  hit hat_two { at = 1/2q; key = "hat"; velocity = 2/5; }
  hit hat_three { at = 1q; key = "hat"; velocity = 3/5; }
  hit hat_four { at = 3/2q; key = "hat"; velocity = 2/5; }
  hit hat_five { at = 2q; key = "hat"; velocity = 3/5; }
  hit hat_six { at = 5/2q; key = "hat"; velocity = 2/5; }
  hit hat_seven { at = 3q; key = "hat"; velocity = 3/5; }
  hit hat_eight { at = 7/2q; key = "hat"; velocity = 2/5; }
}
place intro_drums { pattern = &groove; track = &drums; at = 0q; count = 3; }
place finale_drums { pattern = &groove; track = &drums; at = 93q; count = 2; }

// One recorded phrase (2.4 s = 4q at 100 bpm), five transports.
asset phrase {
  kind = audio; path = "@REL@/phrase.pcm"; hash = "@PHRASE@";
  format = "pcm_f32le_interleaved/1"; rate = 48000Hz; channels = 1; frames = 115200;
}
track clips {}
audio original {
  asset = &phrase; at = 48q; source = [0frame, 115200frame]; mode = rate;
  gain = 4/5; fade_in = 2ms; fade_out = 20ms; track = &clips;
}
audio slow_rate {
  asset = &phrase; at = 53q; source = [0frame, 115200frame];
  mode = warp_rate; warp = [(0q, 0frame), (8q, 115200frame)];
  gain = 4/5; fade_in = 2ms; fade_out = 20ms; track = &clips;
}
audio slow_preserve {
  asset = &phrase; at = 62q; source = [0frame, 115200frame];
  mode = warp_preserve; processor = "core.stretch.ola/1";
  warp = [(0q, 0frame), (8q, 115200frame)];
  gain = 4/5; fade_in = 2ms; fade_out = 20ms; track = &clips;
}
audio fast_preserve {
  asset = &phrase; at = 71q; source = [0frame, 115200frame];
  mode = warp_preserve; processor = "core.stretch.ola/1";
  warp = [(0q, 0frame), (2q, 115200frame)];
  gain = 4/5; fade_in = 2ms; fade_out = 20ms; track = &clips;
}
audio fast_rate {
  asset = &phrase; at = 74q; source = [0frame, 115200frame];
  mode = warp_rate; warp = [(0q, 0frame), (2q, 115200frame)];
  gain = 4/5; fade_in = 2ms; fade_out = 20ms; track = &clips;
}
audio glass_clip {
  asset = &glass; at = 77q; source = [0frame, 57600frame]; mode = rate;
  gain = 1; fade_in = 2ms; fade_out = 20ms; track = &clips;
}
audio finale_phrase {
  asset = &phrase; at = 97q; source = [0frame, 115200frame];
  mode = warp_preserve; processor = "core.stretch.ola/1";
  warp = [(0q, 0frame), (4q, 115200frame)];
  gain = 1/3; fade_in = 2ms; fade_out = 200ms; track = &clips;
}

node mix { type = "core.sum/1"; config = { channels = 1; }; }
// The mono mix is copied to both channels; stereo sources join it on the bus.
node center { type = "core.matrix/1"; config = { inputs = 1; outputs = 2; coefficients = [[1], [1]]; }; }
node bus { type = "core.sum/1"; config = { channels = 2; }; }
node room { type = "fx.reverb/1"; config = { channels = 2; }; params = { mix = 3/20; }; }
node master { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 13/20; }; }
connect keys_route { from = &keys:out; to = &mix:in; }
connect layered_route { from = &layered:out; to = &mix:in; }
connect sweep_route { from = &sweep:out; to = &mix:in; }
connect kit_route { from = &kit:out; to = &mix:in; }
connect original_route { from = &original:out; to = &mix:in; }
connect slow_rate_route { from = &slow_rate:out; to = &mix:in; }
connect slow_preserve_route { from = &slow_preserve:out; to = &mix:in; }
connect fast_preserve_route { from = &fast_preserve:out; to = &mix:in; }
connect fast_rate_route { from = &fast_rate:out; to = &mix:in; }
connect finale_route { from = &finale_phrase:out; to = &mix:in; }
connect center_route { from = &mix:out; to = &center:in; }
connect center_bus_route { from = &center:out; to = &bus:in; }
connect pad_route { from = &pad:out; to = &bus:in; }
connect glass_route { from = &glass_keys:out; to = &bus:in; }
connect glass_clip_route { from = &glass_clip:out; to = &bus:in; }
connect room_route { from = &bus:out; to = &room:in; }
connect master_route { from = &room:out; to = &master:in; }
