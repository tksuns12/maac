  note e1 { at = 33/2q; dur = 1/2q; pitch = F#4; velocity = 0.55; }
  note e2 { at = 17q; dur = 1/2q; pitch = A4; velocity = 0.6; }
  note e3 { at = 35/2q; dur = 1/2q; pitch = A4; velocity = 0.52; }
  note e4 { at = 18q; dur = 1/2q; pitch = B4; velocity = 0.6; }
  note e5 { at = 37/2q; dur = 1q; pitch = D5; velocity = 0.64; }
  note e6 { at = 39/2q; dur = 1/2q; pitch = C#5; velocity = 0.56; }
  note f1 { at = 20q; dur = 1q; pitch = C#5; velocity = 0.6; }
  note f2 { at = 21q; dur = 1/2q; pitch = B4; velocity = 0.52; }
  note f3 { at = 43/2q; dur = 5/2q; pitch = A4; velocity = 0.56; expression vib { kind = pitch; vibrato = &guitar; } }
  note g1 { at = 49/2q; dur = 1/2q; pitch = B4; velocity = 0.55; }
  note g2 { at = 25q; dur = 1/2q; pitch = B4; velocity = 0.56; }
  note g3 { at = 51/2q; dur = 1/2q; pitch = A4; velocity = 0.52; }
  note g4 { at = 26q; dur = 1/2q; pitch = G4; velocity = 0.54; }
  note g5 { at = 53/2q; dur = 1/2q; pitch = F#4; velocity = 0.5; }
  note g6 { at = 27q; dur = 1q; pitch = G4; velocity = 0.56; }
  note h1 { at = 28q; dur = 2q; pitch = A4; velocity = 0.6; expression vib { kind = pitch; vibrato = &guitar; } }
  note h2 { at = 30q; dur = 1/2q; pitch = E4; velocity = 0.5; }
  note h3 { at = 61/2q; dur = 1/2q; pitch = F#4; velocity = 0.54; }
  note h4 { at = 31q; dur = 1/2q; pitch = G4; velocity = 0.58; }
  note h5 { at = 63/2q; dur = 1/2q; pitch = A4; velocity = 0.62; }
}
pattern melody_chorus { length = 32q;
  note a1 { at = 0q; dur = 1q; pitch = B4; velocity = 0.66; }
  note a2 { at = 1q; dur = 1q; pitch = D5; velocity = 0.7; expression bend { kind = pitch; curve = &bend_up; } }
  note a3 { at = 2q; dur = 1/2q; pitch = D5; velocity = 0.6; }
  note a4 { at = 5/2q; dur = 1/2q; pitch = E5; velocity = 0.64; }
  note a5 { at = 3q; dur = 1q; pitch = D5; velocity = 0.62; }
  note b1 { at = 4q; dur = 3/2q; pitch = D5; velocity = 0.66; expression vib { kind = pitch; vibrato = &guitar; } }
  note b2 { at = 11/2q; dur = 1/2q; pitch = A4; velocity = 0.56; }
  note b3 { at = 6q; dur = 2q; pitch = A4; velocity = 0.6; expression vib { kind = pitch; vibrato = &guitar; } }
  note c1 { at = 8q; dur = 1q; pitch = C#5; velocity = 0.66; }
  note c2 { at = 9q; dur = 1q; pitch = E5; velocity = 0.7; expression bend { kind = pitch; curve = &bend_up; } }
  note c3 { at = 10q; dur = 1/2q; pitch = E5; velocity = 0.6; }
  note c4 { at = 21/2q; dur = 1/2q; pitch = F#5; velocity = 0.66; }
  note c5 { at = 11q; dur = 1q; pitch = E5; velocity = 0.62; }
  note d1 { at = 12q; dur = 3/2q; pitch = D5; velocity = 0.66; }
  note d2 { at = 27/2q; dur = 1/2q; pitch = C#5; velocity = 0.56; }
  note d3 { at = 14q; dur = 2q; pitch = B4; velocity = 0.6; expression vib { kind = pitch; vibrato = &guitar; } }
  note e1 { at = 16q; dur = 1q; pitch = B4; velocity = 0.66; }
  note e2 { at = 17q; dur = 1q; pitch = D5; velocity = 0.7; }
  note e3 { at = 18q; dur = 1/2q; pitch = D5; velocity = 0.6; }
  note e4 { at = 37/2q; dur = 1/2q; pitch = E5; velocity = 0.64; }
  note e5 { at = 19q; dur = 1q; pitch = F#5; velocity = 0.7; }
  note f1 { at = 20q; dur = 3/2q; pitch = F#5; velocity = 0.7; expression bend { kind = pitch; curve = &bend_up; vibrato = &guitar; } }
  note f2 { at = 43/2q; dur = 1/2q; pitch = E5; velocity = 0.58; }
  note f3 { at = 22q; dur = 2q; pitch = D5; velocity = 0.62; expression vib { kind = pitch; vibrato = &guitar; } }
  note g1 { at = 24q; dur = 1q; pitch = E5; velocity = 0.66; }
  note g2 { at = 25q; dur = 1/2q; pitch = D5; velocity = 0.58; }
  note g3 { at = 51/2q; dur = 1/2q; pitch = C#5; velocity = 0.56; }
  note g4 { at = 26q; dur = 2q; pitch = A4; velocity = 0.6; expression vib { kind = pitch; vibrato = &guitar; } }
  note h1 { at = 28q; dur = 1/2q; pitch = B4; velocity = 0.56; }
  note h2 { at = 57/2q; dur = 7/2q; pitch = A4; velocity = 0.6; expression vib { kind = pitch; vibrato = &guitar; } }
}
pattern melody_bridge { length = 16q;
  note a1 { at = 0q; dur = 1q; pitch = G4; velocity = 0.58; }
  note a2 { at = 1q; dur = 1q; pitch = B4; velocity = 0.6; }
  note a3 { at = 2q; dur = 2q; pitch = E5; velocity = 0.64; expression bend { kind = pitch; curve = &bend_up; vibrato = &guitar; } }
  note b1 { at = 4q; dur = 3/2q; pitch = D5; velocity = 0.62; }
  note b2 { at = 11/2q; dur = 1/2q; pitch = B4; velocity = 0.54; }
  note b3 { at = 6q; dur = 2q; pitch = D5; velocity = 0.62; expression vib { kind = pitch; vibrato = &guitar; } }
  note c1 { at = 8q; dur = 2q; pitch = F#5; velocity = 0.66; expression bend { kind = pitch; curve = &bend_up; vibrato = &guitar; } }
  note c2 { at = 10q; dur = 1q; pitch = E5; velocity = 0.6; }
  note c3 { at = 11q; dur = 1q; pitch = D5; velocity = 0.6; }
  note d1 { at = 12q; dur = 4q; pitch = E5; velocity = 0.7; expression vib { kind = pitch; vibrato = &guitar; } }
}
track melody { target = &lead:events; }
place melody_verse1 { pattern = &melody_verse; track = &melody; at = 16q; }
place melody_chorus1 { pattern = &melody_chorus; track = &melody; at = 48q; }
place melody_verse2 { pattern = &melody_verse; track = &melody; at = 80q; }
place melody_chorus2 { pattern = &melody_chorus; track = &melody; at = 112q; }
place melody_bridge1 { pattern = &melody_bridge; track = &melody; at = 144q; }
place melody_chorus3 { pattern = &melody_chorus; track = &melody; at = 160q; transpose = 200ct; }

// ---------------------------------------------------------------- pad
voicing pad_d { pitches = [D3, F#3, A3]; }
voicing pad_a { pitches = [C#3, E3, A3]; }
voicing pad_bm { pitches = [D3, F#3, B3]; }
voicing pad_g { pitches = [D3, G3, B3]; }
voicing pad_em { pitches = [E3, G3, B3]; }
voicings pad_voicings { chords = [("D", &pad_d), ("A", &pad_a), ("Bm", &pad_bm), ("G", &pad_g), ("Em", &pad_em)]; }
node pad {
  instrument = &studio.pad; config = { voices = 12; };
  params = { attack = 1s; release = 2s; };
}
pattern pad_bar { length = 4q;
  chord all { at = 0q; dur = 4q; velocity = 0.36; }
}
track pad_notes { target = &pad:events; }
place pad_intro1 { pattern = &pad_bar; track = &pad_notes; at = 0q; count = 4; harmony = &verse_chords; voicings = &pad_voicings; }
place pad_chorus1 { pattern = &pad_bar; track = &pad_notes; at = 48q; count = 8; harmony = &chorus_chords; voicings = &pad_voicings; }
place pad_chorus2 { pattern = &pad_bar; track = &pad_notes; at = 112q; count = 8; harmony = &chorus_chords; voicings = &pad_voicings; }
place pad_bridge1 { pattern = &pad_bar; track = &pad_notes; at = 144q; count = 4; harmony = &bridge_chords; voicings = &pad_voicings; }
place pad_chorus3 { pattern = &pad_bar; track = &pad_notes; at = 160q; count = 8; transpose = 200ct; harmony = &chorus_chords; voicings = &pad_voicings; }
place pad_outro1 { pattern = &pad_bar; track = &pad_notes; at = 192q; count = 4; transpose = 200ct; harmony = &outro_chords; voicings = &pad_voicings; }

// ---------------------------------------------------------------- mix
node bus { type = "core.sum/1"; config = { channels = 2; }; }
node send { type = "core.sum/1"; config = { channels = 2; }; }
node hall { type = "fx.reverb/1"; config = { channels = 2; predelay = 20ms; damping = 0.45; }; params = { mix = 1; decay = 2.2s; }; }
node send_level { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 0.25; }; }
node glue { type = "fx.compressor/1"; config = { channels = 2; }; params = { threshold = -18dB; ratio = 1.5; knee = 6dB; attack = 20ms; release = 150ms; makeup = 0dB; }; }
node master { type = "fx.limiter/1"; config = { channels = 2; }; params = { gain = 3dB; ceiling = -1.1dB; release = 150ms; }; }

connect piano_bus { from = &piano:out; to = &bus:in; }
connect strum_bus { from = &strum:out; to = &bus:in; }
connect bass_bus { from = &bass:out; to = &bus:in; }
connect drums_bus { from = &drums:out; to = &bus:in; }
connect lead_bus { from = &lead:out; to = &bus:in; }
connect pad_bus { from = &pad:out; to = &bus:in; }
connect piano_send { from = &piano:out; to = &send:in; }
connect strum_send { from = &strum:out; to = &send:in; }
connect lead_send { from = &lead:out; to = &send:in; }
connect send_hall { from = &send:out; to = &hall:in; }
connect hall_level { from = &hall:out; to = &send_level:in; }
connect return_bus { from = &send_level:out; to = &bus:in; }
connect bus_glue { from = &bus:out; to = &glue:in; }
connect glue_master { from = &glue:out; to = &master:in; }

// ---------------------------------------------------------------- delivery
// `maac deliver examples/lantern/lantern.maac --delivery release --output-dir out --profile song`
asset schema { kind = descriptor; builtin = "maac.production/1"; }
extension deliveries {
  namespace = "maac.production/1"; schema = &schema; render_affecting = true;
  data = { deliveries = { release = {
    rate = 48000Hz; resampler = "maac.src.kaiser/1";
    targets = { master = {
      role = master; output = &master:out; encoding = wav_pcm24le;
      dither = { type = tpdf; seed = 2026; };
      limits = {
        integrated_loudness = { unit = LUFS; min = -16; max = -13; };
        true_peak = { unit = dBTP; max = -1; };
      };
    }; };
  }; }; };
}
