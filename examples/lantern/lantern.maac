maac 1;

// "Lantern Street": upbeat pop, 100 bpm, D major, 52 bars (~125 s).
// Written directly in MaaC by an AI producer as the T4 production trial.
//
//  1-4   intro: pulsing piano and a low pad
//  5-12  verse: D A Bm G D A G A; piano, bass, kick, hats; the melody on a
//        lightly driven electric guitar
// 13-20  chorus: G D A Bm G D A A; strummed steel guitar, fuller piano,
//        driving bass, the full kit, the pad and a harder lead
// 21-28  verse 2: as verse 1, with light strums
// 29-36  chorus 2
// 37-40  bridge: Em G Bm A at half time, building
// 41-48  last chorus, a whole step up in E
// 49-52  outro: piano and pad on A E B E

project lantern_street {
  score = [0q, 208q]; rate = 48000Hz; tail = 4s;
  tempo = &clock; meter = &metre; output = &master:out;
  requires = ["maac.production/1"];
}
tempo clock { points = [(0q, 100bpm, step)]; }
meter metre { points = [(0q, 4, 4)]; }
import studio { builtin = "std/studio/1.1.0"; }

region intro { span = [bar(1, 1), bar(5, 1)]; }
region verse1 { span = [bar(5, 1), bar(13, 1)]; }
region chorus1 { span = [bar(13, 1), bar(21, 1)]; }
region verse2 { span = [bar(21, 1), bar(29, 1)]; }
region chorus2 { span = [bar(29, 1), bar(37, 1)]; }
region bridge { span = [bar(37, 1), bar(41, 1)]; }
region chorus3 { span = [bar(41, 1), bar(49, 1)]; }
region outro { span = [bar(49, 1), bar(53, 1)]; }

// ---------------------------------------------------------------- harmony
// Each section's chords, once for every part. The intro plays the first four
// bars of the verse; the last chorus and the outro are placed a whole step up.
harmony verse_chords { length = 32q; chords = [(0q, "D"), (4q, "A"), (8q, "Bm"), (12q, "G"), (16q, "D"), (20q, "A"), (24q, "G"), (28q, "A")]; }
harmony chorus_chords { length = 32q; chords = [(0q, "G"), (4q, "D"), (8q, "A"), (12q, "Bm"), (16q, "G"), (20q, "D"), (24q, "A")]; }
harmony bridge_chords { length = 16q; chords = [(0q, "Em"), (4q, "G"), (8q, "Bm"), (12q, "A")]; }
harmony outro_chords { length = 16q; chords = [(0q, "G"), (4q, "D"), (8q, "A"), (12q, "D")]; }

// ---------------------------------------------------------------- piano
// Each piano voicing is a left-hand root under a close right-hand triad;
// `bottom = 1` plays the root and `top = 3` the triad.
voicing pno_d { pitches = [D3, A3, D4, F#4]; }
voicing pno_a { pitches = [A2, A3, C#4, E4]; }
voicing pno_bm { pitches = [B2, B3, D4, F#4]; }
voicing pno_g { pitches = [G2, B3, D4, G4]; }
voicing pno_em { pitches = [E3, B3, E4, G4]; }
voicings piano_voicings { chords = [("D", &pno_d), ("A", &pno_a), ("Bm", &pno_bm), ("G", &pno_g), ("Em", &pno_em)]; }
node piano {
  instrument = &studio.piano; config = { voices = 24; };
  params = { release = 150ms; };
}
// Verse: a held root and a pulse of eighth-note triads.
pattern pno_pulse { length = 4q;
  chord l1 { at = 0q; dur = 2q; bottom = 1; velocity = 0.5; }
  chord l2 { at = 2q; dur = 2q; bottom = 1; velocity = 0.44; }
  chord r1 { at = 0q; dur = 1/2q; top = 3; velocity = 0.52; }
  chord r2 { at = 1/2q; dur = 1/2q; top = 3; velocity = 0.36; }
  chord r3 { at = 1q; dur = 1/2q; top = 3; velocity = 0.44; }
  chord r4 { at = 3/2q; dur = 1/2q; top = 3; velocity = 0.36; }
  chord r5 { at = 2q; dur = 1/2q; top = 3; velocity = 0.48; }
  chord r6 { at = 5/2q; dur = 1/2q; top = 3; velocity = 0.36; }
  chord r7 { at = 3q; dur = 1/2q; top = 3; velocity = 0.44; }
  chord r8 { at = 7/2q; dur = 1/2q; top = 3; velocity = 0.38; }
}
// Chorus: a whole-bar root and pushed quarter-note triads.
pattern pno_drive { length = 4q;
  chord l1 { at = 0q; dur = 4q; bottom = 1; velocity = 0.6; }
  chord r1 { at = 0q; dur = 1q; top = 3; velocity = 0.62; }
  chord r2 { at = 1q; dur = 1/2q; top = 3; velocity = 0.48; }
  chord r3 { at = 3/2q; dur = 1q; top = 3; velocity = 0.56; }
  chord r4 { at = 5/2q; dur = 1/2q; top = 3; velocity = 0.46; }
  chord r5 { at = 3q; dur = 1q; top = 3; velocity = 0.54; }
}
pattern pno_held { length = 4q;
  chord all { at = 0q; dur = 4q; velocity = 0.5; }
}
pattern pno_bridge { length = 16q;
  use held { pattern = &pno_held; at = 0q; count = 3; }
  use pulse { pattern = &pno_pulse; at = 12q; }
}
pattern pno_outro { length = 16q;
  use pulse { pattern = &pno_pulse; at = 0q; count = 2; }
  use held { pattern = &pno_held; at = 8q; }
  chord last { at = 12q; dur = 4q; velocity = 0.46; }
}
track piano_notes { target = &piano:events; }
place piano_intro { pattern = &pno_pulse; track = &piano_notes; at = 0q; count = 4; harmony = &verse_chords; voicings = &piano_voicings; }
place piano_verse1 { pattern = &pno_pulse; track = &piano_notes; at = 16q; count = 8; harmony = &verse_chords; voicings = &piano_voicings; }
place piano_chorus1 { pattern = &pno_drive; track = &piano_notes; at = 48q; count = 8; harmony = &chorus_chords; voicings = &piano_voicings; }
place piano_verse2 { pattern = &pno_pulse; track = &piano_notes; at = 80q; count = 8; harmony = &verse_chords; voicings = &piano_voicings; }
place piano_chorus2 { pattern = &pno_drive; track = &piano_notes; at = 112q; count = 8; harmony = &chorus_chords; voicings = &piano_voicings; }
place piano_bridge { pattern = &pno_bridge; track = &piano_notes; at = 144q; harmony = &bridge_chords; voicings = &piano_voicings; }
place piano_chorus3 { pattern = &pno_drive; track = &piano_notes; at = 160q; count = 8; transpose = 200ct; harmony = &chorus_chords; voicings = &piano_voicings; }
place piano_outro { pattern = &pno_outro; track = &piano_notes; at = 192q; transpose = 200ct; harmony = &outro_chords; voicings = &piano_voicings; }

// ---------------------------------------------------------------- strummed steel guitar
voicing gtr_d { pitches = [D3, A3, D4, F#4]; }
voicing gtr_a { pitches = [A2, E3, A3, C#4, E4]; }
voicing gtr_bm { pitches = [B2, F#3, B3, D4, F#4]; }
voicing gtr_g { pitches = [G2, B2, D3, G3, B3, G4]; }
voicing gtr_em { pitches = [E2, B2, E3, G3, B3, E4]; }
voicings guitar_voicings { chords = [("D", &gtr_d), ("A", &gtr_a), ("Bm", &gtr_bm), ("G", &gtr_g), ("Em", &gtr_em)]; }
// The library steel guitar plucks every string with the same full-band noise
// burst at any velocity. This one picks harder strums brighter, picks a fifth
// of the way along the string, and adds the body's air and top resonances.
instrument steel {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &string:out;
    node amp { type = "synth.adsr/1"; params = { attack = 2ms; sustain = 1; release = 300ms; }; }
    node vel { type = "synth.velocity/1"; }
    node key { type = "synth.key/1"; }
    node string {
      type = "synth.pluck/1";
      config = { seed = 1103515245; };
      params = { decay = 6s; damping = 0.15; level = 1/2; hardness = 1/20; position = 1/5; };
    }
    modulate higher_shorter { from = &key:out; to = &string.params.decay; depth = -1500ms; }
    modulate harder_louder { from = &vel:out; to = &string.params.level; depth = 1/2; }
    modulate harder_brighter { from = &vel:out; to = &string.params.hardness; depth = 9/20; }
  }
  shared body {
    channels = 2;
    output = &gain:out;
    node low_cut { type = "synth.highpass/1"; config = { channels = 1; }; params = { cutoff = 75Hz; }; }
    node air { type = "synth.svf/1"; config = { channels = 1; mode = bandpass; }; params = { cutoff = 105Hz; q = 2; }; }
    node air_level { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.9; }; }
    node top_plate { type = "synth.svf/1"; config = { channels = 1; mode = bandpass; }; params = { cutoff = 215Hz; q = 2; }; }
    node top_level { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 0.8; }; }
    node wood { type = "synth.mix/1"; config = { channels = 1; }; }
    node brightness { type = "synth.svf/1"; config = { channels = 1; mode = lowpass; }; params = { cutoff = 7000Hz; q = 0.7; }; }
    node stereo { type = "synth.pan/1"; params = { pan = 0; }; }
    node gain { type = "synth.gain/1"; config = { channels = 2; }; params = { level = 0.3; }; }
    connect input_cut { from = &input:out; to = &low_cut:in; }
    connect cut_air { from = &low_cut:out; to = &air:in; }
    connect air_trim { from = &air:out; to = &air_level:in; }
    connect air_wood { from = &air_level:out; to = &wood:in; }
    connect cut_top { from = &low_cut:out; to = &top_plate:in; }
    connect top_trim { from = &top_plate:out; to = &top_level:in; }
    connect top_wood { from = &top_level:out; to = &wood:in; }
    connect dry_wood { from = &low_cut:out; to = &wood:in; }
    connect wood_bright { from = &wood:out; to = &brightness:in; }
    connect bright_stereo { from = &brightness:out; to = &stereo:in; }
    connect stereo_gain { from = &stereo:out; to = &gain:in; }
  }
  control level { target = &body.gain.params.level; default = 0.3; }
  control brightness { target = &body.brightness.params.cutoff; default = 7000Hz; }
  control release { target = &voice.amp.params.release; default = 300ms; }
  control pan { target = &body.stereo.params.pan; default = 0; }
}
node strum {
  instrument = &steel; config = { voices = 32; };
  params = { level = 0.24; pan = -0.35; };
}
// Chorus: down, down, up, up, down, up.
pattern strum_drive { length = 4q;
  chord d1 { at = 0q; dur = 1q; strum = down; velocity = 0.78; tilt = -0.12; }
  chord d2 { at = 1q; dur = 1/2q; strum = down; velocity = 0.6; tilt = -0.08; }
  chord u1 { at = 3/2q; dur = 1q; top = 4; strum = up; velocity = 0.46; tilt = -0.06; }
  chord u2 { at = 5/2q; dur = 1/2q; top = 4; strum = up; velocity = 0.48; tilt = -0.06; }
  chord d3 { at = 3q; dur = 1/2q; strum = down; velocity = 0.66; tilt = -0.1; }
  chord u3 { at = 7/2q; dur = 1/2q; top = 4; strum = up; velocity = 0.46; tilt = -0.06; }
}
// Verse 2: two downstrokes left ringing and an upstroke into the next bar.
pattern strum_light { length = 4q;
  chord d1 { at = 0q; dur = 2q; strum = down; velocity = 0.6; tilt = -0.1; }
  chord d2 { at = 2q; dur = 3/2q; strum = down; velocity = 0.5; tilt = -0.08; }
  chord u1 { at = 7/2q; dur = 1/2q; top = 4; strum = up; velocity = 0.4; tilt = -0.05; }
}
pattern strum_ring { length = 4q;
  chord d1 { at = 0q; dur = 4q; strum = down; stagger = 25ms; velocity = 0.62; tilt = -0.1; }
}
pattern strum_bridge { length = 16q;
  use ring { pattern = &strum_ring; at = 0q; count = 3; }
  use drive { pattern = &strum_drive; at = 12q; }
}
track strums { target = &strum:events; }
place strum_chorus1 { pattern = &strum_drive; track = &strums; at = 48q; count = 8; harmony = &chorus_chords; voicings = &guitar_voicings; }
place strum_verse2 { pattern = &strum_light; track = &strums; at = 80q; count = 8; harmony = &verse_chords; voicings = &guitar_voicings; }
place strum_chorus2 { pattern = &strum_drive; track = &strums; at = 112q; count = 8; harmony = &chorus_chords; voicings = &guitar_voicings; }
place strum_bridge1 { pattern = &strum_bridge; track = &strums; at = 144q; harmony = &bridge_chords; voicings = &guitar_voicings; }
place strum_chorus3 { pattern = &strum_drive; track = &strums; at = 160q; count = 8; transpose = 200ct; harmony = &chorus_chords; voicings = &guitar_voicings; }

// ---------------------------------------------------------------- bass
node bass {
  instrument = &studio.bass; config = { voices = 6; };
  params = { release = 150ms; };
}
// Each bass voicing is the root and its octave: `bottom = 1` plays the
// root and `top = 1` the octave.
voicing bs_d { pitches = [D2, D3]; }
voicing bs_a { pitches = [A1, A2]; }
voicing bs_bm { pitches = [B1, B2]; }
voicing bs_g { pitches = [G1, G2]; }
voicing bs_em { pitches = [E2, E3]; }
voicings bass_voicings { chords = [("D", &bs_d), ("A", &bs_a), ("Bm", &bs_bm), ("G", &bs_g), ("Em", &bs_em)]; }
pattern bs_verse { length = 4q;
  chord r1 { at = 0q; dur = 3/2q; bottom = 1; velocity = 0.72; }
  chord r2 { at = 3/2q; dur = 1/2q; bottom = 1; velocity = 0.5; }
  chord r3 { at = 2q; dur = 3/2q; bottom = 1; velocity = 0.66; }
  chord o1 { at = 7/2q; dur = 1/2q; top = 1; velocity = 0.48; }
}
pattern bs_drive { length = 4q;
  chord e1 { at = 0q; dur = 1/2q; bottom = 1; velocity = 0.76; }
  chord e2 { at = 1/2q; dur = 1/2q; bottom = 1; velocity = 0.54; }
  chord e3 { at = 1q; dur = 1/2q; bottom = 1; velocity = 0.66; }
  chord e4 { at = 3/2q; dur = 1/2q; bottom = 1; velocity = 0.54; }
  chord e5 { at = 2q; dur = 1/2q; bottom = 1; velocity = 0.72; }
  chord e6 { at = 5/2q; dur = 1/2q; bottom = 1; velocity = 0.54; }
  chord e7 { at = 3q; dur = 1/2q; bottom = 1; velocity = 0.66; }
  chord e8 { at = 7/2q; dur = 1/2q; bottom = 1; velocity = 0.56; }
}
pattern bs_held { length = 4q;
  chord r1 { at = 0q; dur = 4q; bottom = 1; velocity = 0.66; }
}
pattern bass_bridge { length = 16q;
  use held { pattern = &bs_held; at = 0q; count = 3; }
  use drive { pattern = &bs_drive; at = 12q; }
}
track bass_notes { target = &bass:events; }
place bass_verse1 { pattern = &bs_verse; track = &bass_notes; at = 16q; count = 8; harmony = &verse_chords; voicings = &bass_voicings; }
place bass_chorus1 { pattern = &bs_drive; track = &bass_notes; at = 48q; count = 8; harmony = &chorus_chords; voicings = &bass_voicings; }
place bass_verse2 { pattern = &bs_verse; track = &bass_notes; at = 80q; count = 8; harmony = &verse_chords; voicings = &bass_voicings; }
place bass_chorus2 { pattern = &bs_drive; track = &bass_notes; at = 112q; count = 8; harmony = &chorus_chords; voicings = &bass_voicings; }
place bass_bridge1 { pattern = &bass_bridge; track = &bass_notes; at = 144q; harmony = &bridge_chords; voicings = &bass_voicings; }
place bass_chorus3 { pattern = &bs_drive; track = &bass_notes; at = 160q; count = 8; transpose = 200ct; harmony = &chorus_chords; voicings = &bass_voicings; }
place bass_outro1 { pattern = &bs_held; track = &bass_notes; at = 192q; count = 4; transpose = 200ct; harmony = &outro_chords; voicings = &bass_voicings; }

// ---------------------------------------------------------------- drums
node drums {
  instrument = &studio.drums;
  params = { hat_pan = 0.25; open_hat_pan = 0.25; low_tom_pan = -0.2; high_tom_pan = 0.2; };
}
pattern hats8 { length = 4q;
  hit h1 { at = 0q; key = "hat"; velocity = 0.55; }
  hit h2 { at = 1/2q; key = "hat"; velocity = 0.34; }
  hit h3 { at = 1q; key = "hat"; velocity = 0.5; }
  hit h4 { at = 3/2q; key = "hat"; velocity = 0.34; }
  hit h5 { at = 2q; key = "hat"; velocity = 0.54; }
  hit h6 { at = 5/2q; key = "hat"; velocity = 0.34; }
  hit h7 { at = 3q; key = "hat"; velocity = 0.5; }
  hit h8 { at = 7/2q; key = "hat"; velocity = 0.38; }
}
pattern kit_verse { length = 4q;
  hit k1 { at = 0q; key = "kick"; velocity = 0.8; }
  hit k2 { at = 5/2q; key = "kick"; velocity = 0.62; }
  hit s1 { at = 1q; key = "snare"; velocity = 0.55; }
  hit s2 { at = 3q; key = "snare"; velocity = 0.58; }
  use hats { pattern = &hats8; at = 0q; }
}
// Chorus: four on the floor under the backbeat, the hat opening on the and of 4.
pattern kit_chorus { length = 4q;
  hit k1 { at = 0q; key = "kick"; velocity = 0.86; }
  hit k2 { at = 1q; key = "kick"; velocity = 0.7; }
  hit k3 { at = 2q; key = "kick"; velocity = 0.82; }
  hit k4 { at = 3q; key = "kick"; velocity = 0.7; }
  hit s1 { at = 1q; key = "snare"; velocity = 0.8; }
  hit s2 { at = 3q; key = "snare"; velocity = 0.84; }
  hit h1 { at = 0q; key = "hat"; velocity = 0.6; }
  hit h2 { at = 1/2q; key = "hat"; velocity = 0.4; }
  hit h3 { at = 1q; key = "hat"; velocity = 0.55; }
  hit h4 { at = 3/2q; key = "hat"; velocity = 0.4; }
  hit h5 { at = 2q; key = "hat"; velocity = 0.6; }
  hit h6 { at = 5/2q; key = "hat"; velocity = 0.4; }
  hit h7 { at = 3q; key = "hat"; velocity = 0.55; }
  hit o1 { at = 7/2q; key = "open_hat"; velocity = 0.5; }
}
// Bridge: half time, the snare on 3.
pattern kit_bridge { length = 4q;
  hit k1 { at = 0q; key = "kick"; velocity = 0.78; }
  hit k2 { at = 3/2q; key = "kick"; velocity = 0.55; }
  hit s1 { at = 2q; key = "snare"; velocity = 0.7; }
  hit h1 { at = 0q; key = "hat"; velocity = 0.45; }
  hit h2 { at = 1q; key = "hat"; velocity = 0.4; }
  hit h3 { at = 2q; key = "hat"; velocity = 0.45; }
  hit h4 { at = 3q; key = "hat"; velocity = 0.4; }
}
// The last bar of a section: a backbeat, then sixteenth snares rising.
pattern kit_fill { length = 4q;
  hit k1 { at = 0q; key = "kick"; velocity = 0.8; }
  hit s1 { at = 1q; key = "snare"; velocity = 0.7; }
  hit s2 { at = 2q; key = "snare"; velocity = 0.5; }
  hit s3 { at = 9/4q; key = "snare"; velocity = 0.54; }
  hit s4 { at = 5/2q; key = "snare"; velocity = 0.58; }
  hit s5 { at = 11/4q; key = "snare"; velocity = 0.62; }
  hit s6 { at = 3q; key = "snare"; velocity = 0.66; }
  hit s7 { at = 13/4q; key = "snare"; velocity = 0.7; }
  hit s8 { at = 7/2q; key = "snare"; velocity = 0.76; }
  hit s9 { at = 15/4q; key = "snare"; velocity = 0.82; }
}
pattern crash_hit { length = 4q;
  hit c1 { at = 0q; key = "crash"; velocity = 0.75; }
}
track kit_hits { target = &drums:events; }
place kit_verse1 { pattern = &kit_verse; track = &kit_hits; at = 16q; count = 7; }
place kit_fill1 { pattern = &kit_fill; track = &kit_hits; at = 44q; }
place kit_chorus1 { pattern = &kit_chorus; track = &kit_hits; at = 48q; count = 7; }
place kit_fill2 { pattern = &kit_fill; track = &kit_hits; at = 76q; }
place kit_verse2 { pattern = &kit_verse; track = &kit_hits; at = 80q; count = 7; }
place kit_fill3 { pattern = &kit_fill; track = &kit_hits; at = 108q; }
place kit_chorus2 { pattern = &kit_chorus; track = &kit_hits; at = 112q; count = 7; }
place kit_fill4 { pattern = &kit_fill; track = &kit_hits; at = 140q; }
place kit_bridge1 { pattern = &kit_bridge; track = &kit_hits; at = 144q; count = 3; }
place kit_fill5 { pattern = &kit_fill; track = &kit_hits; at = 156q; }
place kit_chorus3 { pattern = &kit_chorus; track = &kit_hits; at = 160q; count = 8; }
place crash_chorus1 { pattern = &crash_hit; track = &kit_hits; at = 48q; }
place crash_chorus2 { pattern = &crash_hit; track = &kit_hits; at = 112q; }
place crash_bridge { pattern = &crash_hit; track = &kit_hits; at = 144q; }
place crash_chorus3 { pattern = &crash_hit; track = &kit_hits; at = 160q; }
place crash_outro { pattern = &crash_hit; track = &kit_hits; at = 192q; }

// ---------------------------------------------------------------- lead guitar
node lead {
  instrument = &studio.electric_guitar; config = { voices = 6; };
  params = { level = 4; drive = 5; pickup = 0.3; tone = 3200Hz; pan = 0.15; release = 250ms; };
}
// The amp holds its level as the drive changes, so only the drive moves.
curve lead_drive {
  clock = score;
  points = [(0q, 5, step), (48q, 10, step), (80q, 5, step), (112q, 10, step), (144q, 8, step), (160q, 12, step), (192q, 5, step)];
}
automation lead_push { target = &lead.params.drive; curve = &lead_drive; at = 0q; }
// The verse is sparse and the chorus dense, so the lead's level follows.
curve lead_level {
  clock = score;
  points = [(0q, 3.6, step), (48q, 4.6, step), (80q, 3.6, step), (112q, 4.6, step), (144q, 4.2, step), (160q, 4.8, step)];
}
automation lead_balance { target = &lead.params.level; curve = &lead_level; at = 0q; }
// A guitarist bends only upwards: the vibrato rises from the fretted pitch
// and back, starts after the pick, and deepens. Bends pick a whole step
// below and push up to the note.
vibrato guitar { rate = 11/2Hz; depth = 38ct; delay = 300ms; rise = 450ms; shape = up; }
curve bend_up {
  clock = seconds;
  points = [(0ms, -200ct, step), (40ms, -200ct, linear), (170ms, 0ct, step)];
}
pattern melody_verse { length = 32q;
  note a1 { at = 1/2q; dur = 1/2q; pitch = F#4; velocity = 0.55; }
  note a2 { at = 1q; dur = 1/2q; pitch = A4; velocity = 0.6; }
  note a3 { at = 3/2q; dur = 1/2q; pitch = A4; velocity = 0.52; }
  note a4 { at = 2q; dur = 1/2q; pitch = B4; velocity = 0.6; }
  note a5 { at = 5/2q; dur = 1q; pitch = A4; velocity = 0.56; }
  note a6 { at = 7/2q; dur = 1/2q; pitch = F#4; velocity = 0.5; }
  note b1 { at = 4q; dur = 3/2q; pitch = E4; velocity = 0.58; }
  note b2 { at = 11/2q; dur = 1/2q; pitch = D4; velocity = 0.5; }
  note b3 { at = 6q; dur = 2q; pitch = E4; velocity = 0.56; expression vib { kind = pitch; vibrato = &guitar; } }
  note c1 { at = 17/2q; dur = 1/2q; pitch = F#4; velocity = 0.55; }
  note c2 { at = 9q; dur = 1/2q; pitch = A4; velocity = 0.58; }
  note c3 { at = 19/2q; dur = 1/2q; pitch = B4; velocity = 0.56; }
  note c4 { at = 10q; dur = 1q; pitch = D5; velocity = 0.64; expression bend { kind = pitch; curve = &bend_up; } }
  note c5 { at = 11q; dur = 1/2q; pitch = B4; velocity = 0.54; }
  note c6 { at = 23/2q; dur = 1/2q; pitch = A4; velocity = 0.5; }
  note d1 { at = 12q; dur = 3/2q; pitch = B4; velocity = 0.6; expression vib { kind = pitch; vibrato = &guitar; } }
  note d2 { at = 27/2q; dur = 1/2q; pitch = A4; velocity = 0.5; }
  note d3 { at = 14q; dur = 1q; pitch = G4; velocity = 0.54; }
