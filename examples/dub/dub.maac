maac 1;

// "Low Tide": a roots dub in G minor at 74 bpm, one-drop, for drums, bass,
// skank guitar, organ, melodica and siren. Written directly in MaaC by an AI
// producer as the T9 production trial. The riddim plays throughout, and the
// desk plays the dub: it drops parts out and back in, throws single hits into
// a tape echo whose repeats darken and swing across the stereo field, lets the
// echo run away and cuts it back, sweeps the drums, and cries with a siren.
// Version 4 writes each throw in the placement of the hit it throws, and
// renders sample for sample as version 3, whose throws were points counted
// by hand in one curve per send (T9's F68).
//
//    0q  intro: drums through a closing low-pass that opens, siren
//   16q  riddim_a: the full riddim and the melodica
//   48q  dub_1: bass and skank drop in and out, throws, a swell
//   80q  riddim_b: the full riddim, the melodica's answer
//  112q  dub_2: drums and bass, a high-pass sweep, the echo's speed changes
//  160q  riddim_c: steppers
//  192q  outro: the parts leave one by one; the last chord into the echo

project low_tide {
  score = [0q, 224q]; rate = 48000Hz; tail = 8s;
  tempo = &clock; meter = &metre; output = &master:out;
  requires = ["maac.production/1"];
}
tempo clock { points = [(0q, 74bpm, step)]; }
meter metre { points = [(0q, 4, 4)]; }
region intro { span = [0q, 16q]; }
region riddim_a { span = [16q, 48q]; }
region dub_1 { span = [48q, 80q]; }
region riddim_b { span = [80q, 112q]; }
region dub_2 { span = [112q, 160q]; }
region riddim_c { span = [160q, 192q]; }
region outro { span = [192q, 224q]; }

import studio { builtin = "std/studio/1.2.0"; }
import basic { builtin = "std/basic/1.1.0"; }

// ---------------------------------------------------------------- instruments
// A melodica: a reed's saw and square over a sine at the fundamental,
// through a low-pass for the small body and a high-pass, with a little
// breath. A slow, shallow vibrato.
instrument melodica {
  channels = 2;
  voice voice {
    channels = 1; amplitude = &amp; output = &thin:out;
    node amp { type = "synth.adsr/1"; params = { attack = 25ms; decay = 90ms; sustain = 0.85; release = 90ms; }; }
    node wobble { type = "synth.lfo/1"; params = { frequency = 4.5Hz; }; }
    node reed_saw { type = "synth.saw/1"; params = { level = 0.55; }; }
    node reed_square { type = "synth.square/1"; params = { level = 0.15; }; }
    node reed_core { type = "synth.sine/1"; params = { level = 0.5; }; }
    node breath { type = "synth.noise/1"; params = { level = 0.06; }; }
    node reed { type = "synth.mix/1"; config = { channels = 1; }; }
    node body { type = "synth.svf/1"; config = { channels = 1; mode = lowpass; }; params = { cutoff = 2200Hz; q = 0.9; }; }
    node thin { type = "synth.highpass/1"; config = { channels = 1; }; params = { cutoff = 250Hz; }; }
    connect saw_reed { from = &reed_saw:out; to = &reed:in; }
    connect square_reed { from = &reed_square:out; to = &reed:in; }
    connect core_reed { from = &reed_core:out; to = &reed:in; }
    connect breath_reed { from = &breath:out; to = &reed:in; }
    connect reed_body { from = &reed:out; to = &body:in; }
    connect body_thin { from = &body:out; to = &thin:in; }
    modulate wobble_saw { from = &wobble:out; to = &reed_saw.params.frequency; depth = 2Hz; }
    modulate wobble_square { from = &wobble:out; to = &reed_square.params.frequency; depth = 2Hz; }
    modulate wobble_core { from = &wobble:out; to = &reed_core.params.frequency; depth = 2Hz; }
  }
  shared output {
    channels = 2; output = &place:out;
    node soften { type = "synth.onepole/1"; config = { channels = 1; }; params = { cutoff = 6000Hz; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 1; }; }
    node place { type = "synth.pan/1"; }
    connect input_soften { from = &input:out; to = &soften:in; }
    connect soften_gain { from = &soften:out; to = &gain:in; }
    connect gain_place { from = &gain:out; to = &place:in; }
  }
  control level { target = &output.gain.params.level; default = 1; }
  control pan { target = &output.place.params.pan; default = 0; }
}

// A dub siren: a triangle whose pitch a fast LFO wobbles; each note's pitch
// curve sweeps it up, through a drive.
instrument siren {
  channels = 2;
  voice voice {
    channels = 1; amplitude = &amp; output = &tone:out;
    node amp { type = "synth.adsr/1"; params = { attack = 40ms; sustain = 1; release = 400ms; }; }
    node wail { type = "synth.lfo/1"; params = { frequency = 6Hz; }; }
    node tone { type = "synth.triangle/1"; }
    modulate wail_tone { from = &wail:out; to = &tone.params.frequency; depth = 60Hz; }
  }
  shared output {
    channels = 2; output = &place:out;
    node heat { type = "synth.drive/1"; config = { channels = 1; }; params = { drive = 3; reference = 1/2; }; }
    node gain { type = "synth.gain/1"; config = { channels = 1; }; params = { level = 1; }; }
    node place { type = "synth.pan/1"; }
    connect input_heat { from = &input:out; to = &heat:in; }
    connect heat_gain { from = &heat:out; to = &gain:in; }
    connect gain_place { from = &gain:out; to = &place:in; }
  }
  control level { target = &output.gain.params.level; default = 1; }
  control pan { target = &output.place.params.pan; default = 0; }
}

// ---------------------------------------------------------------- effects
// A tape echo for throws, in three parts, because an effect cannot hold a
// feedback loop (T9's F70): the tape, what each pass does to the sound, and
// the spread of the returns. The loop itself is in the desk below.
effect tape {
  channels = 2;
  shared main {
    channels = 2; output = &line:out;
    node line { type = "synth.delay/1"; config = { channels = 2; clock = score; max = 4s; }; params = { time = 3/4q; }; }
    connect in_line { from = &input:out; to = &line:in; }
  }
  control time { target = &main.line.params.time; default = 3/4q; }
}
// Each pass saturates the tape, loses low end and darkens.
effect wear {
  channels = 2;
  shared main {
    channels = 2; output = &dark:out;
    node heat { type = "synth.drive/1"; config = { channels = 2; }; params = { drive = 2; reference = 1/4; }; }
    node thin { type = "synth.highpass/1"; config = { channels = 2; }; params = { cutoff = 300Hz; }; }
    node dark { type = "synth.onepole/1"; config = { channels = 2; }; params = { cutoff = 3200Hz; }; }
    connect in_heat { from = &input:out; to = &heat:in; }
    connect heat_thin { from = &heat:out; to = &thin:in; }
    connect thin_dark { from = &thin:out; to = &dark:in; }
  }
}
// The returns lean from side to side and open a little wider.
effect spread {
  channels = 2;
  shared main {
    channels = 2; output = &wide:out;
    node lean { type = "synth.balance/1"; }
    node wide { type = "synth.width/1"; params = { width = 1.3; }; }
    connect in_lean { from = &input:out; to = &lean:in; }
    connect lean_wide { from = &lean:out; to = &wide:in; }
  }
  control balance { target = &main.lean.params.balance; default = 0; }
}

// A skank's guitar keeps no low end.
effect thin {
  channels = 2;
  shared main {
    channels = 2; output = &cut:out;
    node cut { type = "synth.highpass/1"; config = { channels = 2; }; params = { cutoff = 600Hz; }; }
    connect in_cut { from = &input:out; to = &cut:in; }
  }
}

// The drum sweep: a low-pass and a high-pass in a row, each behind a control.
effect sweep {
  channels = 2;
  shared main {
    channels = 2; output = &high:out;
    node low { type = "synth.svf/1"; config = { channels = 2; mode = lowpass; }; params = { cutoff = 18000Hz; }; }
    node high { type = "synth.svf/1"; config = { channels = 2; mode = highpass; }; params = { cutoff = 20Hz; }; }
    connect in_low { from = &input:out; to = &low:in; }
    connect low_high { from = &low:out; to = &high:in; }
  }
  control low { target = &main.low.params.cutoff; default = 18000Hz; }
  control high { target = &main.high.params.cutoff; default = 20Hz; }
}

// ---------------------------------------------------------------- the riddim
harmony riddim { length = 16q; chords = [(0q, "Gm"), (8q, "Eb"), (12q, "F")]; }
voicing skank_gm { pitches = [D4, G4, Bb4]; }
voicing skank_eb { pitches = [Eb4, G4, Bb4]; }
voicing skank_f { pitches = [F4, A4, C5]; }
voicings skank_voicings { chords = [("Gm", &skank_gm), ("Eb", &skank_eb), ("F", &skank_f)]; }
voicing bubble_gm { pitches = [G3, Bb3, D4]; }
voicing bubble_eb { pitches = [G3, Bb3, Eb4]; }
voicing bubble_f { pitches = [F3, A3, C4]; }
voicings bubble_voicings { chords = [("Gm", &bubble_gm), ("Eb", &bubble_eb), ("F", &bubble_f)]; }

groove lilt { grid = 1/2q; ratio = 11/20; }
vary hands { seed = 9; velocity = 1/20; timing = 6ms; }

// One-drop: the kick lands with the snare on beat three, nothing on one.
pattern one_drop { length = 4q;
  hit h1 { at = 0q; key = "hat"; velocity = 0.32; }
  hit h2 { at = 1/2q; key = "hat"; velocity = 0.5; }
  hit h3 { at = 1q; key = "hat"; velocity = 0.34; }
  hit h4 { at = 3/2q; key = "hat"; velocity = 0.52; }
  hit k { at = 2q; key = "kick"; velocity = 0.85; }
  hit h5 { at = 2q; key = "hat"; velocity = 0.3; }
  hit h6 { at = 5/2q; key = "hat"; velocity = 0.5; }
  hit h7 { at = 3q; key = "hat"; velocity = 0.34; }
  hit o { at = 7/2q; key = "open_hat"; velocity = 0.4; }
}
// Steppers: the kick on every beat.
pattern steppers { length = 4q;
  hit k1 { at = 0q; key = "kick"; velocity = 0.8; }
  hit h1 { at = 1/2q; key = "hat"; velocity = 0.5; }
  hit k2 { at = 1q; key = "kick"; velocity = 0.72; }
  hit h2 { at = 3/2q; key = "hat"; velocity = 0.52; }
  hit k3 { at = 2q; key = "kick"; velocity = 0.85; }
  hit h3 { at = 5/2q; key = "hat"; velocity = 0.5; }
  hit k4 { at = 3q; key = "kick"; velocity = 0.72; }
  hit o { at = 7/2q; key = "open_hat"; velocity = 0.42; }
}
// The snare is its own node, so that the desk can throw it alone.
pattern drop_snare { length = 4q;
  note s { at = 2q; dur = 1/4q; pitch = C2; velocity = 0.78; }
}
pattern drop_snare_ghost { length = 4q;
  note g { at = 3/2q; dur = 1/8q; pitch = C2; velocity = 0.22; }
  note s { at = 2q; dur = 1/4q; pitch = C2; velocity = 0.78; }
  note g2 { at = 15/4q; dur = 1/8q; pitch = C2; velocity = 0.2; }
}

pattern bass_line { length = 16q;
  note n1 { at = 0q; dur = 3/2q; pitch = G2; velocity = 0.8; }
  note n2 { at = 3/2q; dur = 1/2q; pitch = G2; velocity = 0.6; }
  note n3 { at = 2q; dur = 1q; pitch = Bb2; velocity = 0.72; }
  note n4 { at = 3q; dur = 1/2q; pitch = D3; velocity = 0.7; }
  note n5 { at = 7/2q; dur = 1/2q; pitch = C3; velocity = 0.62; }
  note n6 { at = 4q; dur = 3/2q; pitch = Bb2; velocity = 0.78; }
  note n7 { at = 11/2q; dur = 1/2q; pitch = A2; velocity = 0.6; }
  note n8 { at = 6q; dur = 3/2q; pitch = G2; velocity = 0.75; }
  note n9 { at = 15/2q; dur = 1/2q; pitch = F2; velocity = 0.6; }
  note n10 { at = 8q; dur = 3/2q; pitch = Eb2; velocity = 0.8; }
  note n11 { at = 19/2q; dur = 1/2q; pitch = Eb2; velocity = 0.6; }
  note n12 { at = 10q; dur = 1q; pitch = G2; velocity = 0.72; }
  note n13 { at = 11q; dur = 1q; pitch = Bb2; velocity = 0.7; }
  note n14 { at = 12q; dur = 3/2q; pitch = F2; velocity = 0.8; }
  note n15 { at = 27/2q; dur = 1/2q; pitch = A2; velocity = 0.6; }
  note n16 { at = 14q; dur = 1q; pitch = C3; velocity = 0.72; }
  note n17 { at = 15q; dur = 1/2q; pitch = A2; velocity = 0.62; }
  note n18 { at = 31/2q; dur = 1/2q; pitch = F2; velocity = 0.6; }
}

// The skank: short, bright chords on beats two and four, choked at once.
pattern skank { length = 16q;
  chord c1 { at = 1q; dur = 1/8q; velocity = 0.7; }
  chord c2 { at = 3q; dur = 1/8q; velocity = 0.66; }
  chord c3 { at = 5q; dur = 1/8q; velocity = 0.7; }
  chord c4 { at = 7q; dur = 1/8q; velocity = 0.66; }
  chord c5 { at = 9q; dur = 1/8q; velocity = 0.7; }
  chord c6 { at = 11q; dur = 1/8q; velocity = 0.66; }
  chord c7 { at = 13q; dur = 1/8q; velocity = 0.7; }
  chord c8 { at = 15q; dur = 1/8q; velocity = 0.66; }
}
// The bubble: soft organ chords on the off-beat eighths.
pattern bubble { length = 16q;
  chord b1 { at = 1/2q; dur = 1/4q; velocity = 0.5; }
  chord b2 { at = 3/2q; dur = 1/4q; velocity = 0.42; }
  chord b3 { at = 5/2q; dur = 1/4q; velocity = 0.5; }
  chord b4 { at = 7/2q; dur = 1/4q; velocity = 0.42; }
  chord b5 { at = 9/2q; dur = 1/4q; velocity = 0.5; }
  chord b6 { at = 11/2q; dur = 1/4q; velocity = 0.42; }
  chord b7 { at = 13/2q; dur = 1/4q; velocity = 0.5; }
  chord b8 { at = 15/2q; dur = 1/4q; velocity = 0.42; }
  chord b9 { at = 17/2q; dur = 1/4q; velocity = 0.5; }
  chord b10 { at = 19/2q; dur = 1/4q; velocity = 0.42; }
  chord b11 { at = 21/2q; dur = 1/4q; velocity = 0.5; }
  chord b12 { at = 23/2q; dur = 1/4q; velocity = 0.42; }
  chord b13 { at = 25/2q; dur = 1/4q; velocity = 0.5; }
  chord b14 { at = 27/2q; dur = 1/4q; velocity = 0.42; }
  chord b15 { at = 29/2q; dur = 1/4q; velocity = 0.5; }
  chord b16 { at = 31/2q; dur = 1/4q; velocity = 0.42; }
}
pattern last_chord { length = 4q; chord c { at = 0q; dur = 1/8q; velocity = 0.74; } }

// ---------------------------------------------------------------- the melodica
pattern melody_a { length = 32q;
  note n1 { at = 0q; dur = 3/2q; pitch = D5; velocity = 0.7; }
  note n2 { at = 3/2q; dur = 1/2q; pitch = C5; velocity = 0.6; }
  note n3 { at = 2q; dur = 1q; pitch = Bb4; velocity = 0.66; }
  note n4 { at = 3q; dur = 1q; pitch = G4; velocity = 0.62; }
  note n5 { at = 4q; dur = 1/2q; pitch = A4; velocity = 0.6; }
  note n6 { at = 9/2q; dur = 1/2q; pitch = Bb4; velocity = 0.62; }
  note n7 { at = 5q; dur = 1q; pitch = C5; velocity = 0.66; }
  note n8 { at = 6q; dur = 2q; pitch = D5; velocity = 0.72; }
  note n9 { at = 8q; dur = 3/2q; pitch = G5; velocity = 0.74; }
  note n10 { at = 19/2q; dur = 1/2q; pitch = F5; velocity = 0.6; }
  note n11 { at = 10q; dur = 1q; pitch = Eb5; velocity = 0.66; }
  note n12 { at = 11q; dur = 1q; pitch = D5; velocity = 0.62; }
  note n13 { at = 12q; dur = 1/2q; pitch = C5; velocity = 0.6; }
  note n14 { at = 25/2q; dur = 1/2q; pitch = D5; velocity = 0.62; }
  note n15 { at = 13q; dur = 1/2q; pitch = C5; velocity = 0.58; }
  note n16 { at = 27/2q; dur = 1/2q; pitch = A4; velocity = 0.6; }
  note n17 { at = 14q; dur = 2q; pitch = F4; velocity = 0.68; }
  note n18 { at = 16q; dur = 1q; pitch = D5; velocity = 0.7; }
  note n19 { at = 17q; dur = 1/2q; pitch = F5; velocity = 0.64; }
  note n20 { at = 35/2q; dur = 1/2q; pitch = G5; velocity = 0.66; }
  note n21 { at = 18q; dur = 1q; pitch = F5; velocity = 0.7; }
  note n22 { at = 19q; dur = 1q; pitch = D5; velocity = 0.62; }
  note n23 { at = 20q; dur = 1/2q; pitch = C5; velocity = 0.6; }
  note n24 { at = 41/2q; dur = 1/2q; pitch = D5; velocity = 0.62; }
  note n25 { at = 21q; dur = 1q; pitch = Bb4; velocity = 0.64; }
  note n26 { at = 22q; dur = 2q; pitch = G4; velocity = 0.7; }
  note n27 { at = 24q; dur = 1/2q; pitch = Bb4; velocity = 0.62; }
  note n28 { at = 49/2q; dur = 1/2q; pitch = C5; velocity = 0.6; }
  note n29 { at = 25q; dur = 1q; pitch = Eb5; velocity = 0.7; }
  note n30 { at = 26q; dur = 1/2q; pitch = D5; velocity = 0.62; }
  note n31 { at = 53/2q; dur = 1/2q; pitch = C5; velocity = 0.6; }
  note n32 { at = 27q; dur = 1q; pitch = Bb4; velocity = 0.64; }
  note n33 { at = 28q; dur = 1q; pitch = A4; velocity = 0.62; }
  note n34 { at = 29q; dur = 1q; pitch = C5; velocity = 0.66; }
  note n35 { at = 30q; dur = 2q; pitch = G4; velocity = 0.7; }
}
pattern melody_b { length = 32q;
  note n1 { at = 0q; dur = 1q; pitch = G5; velocity = 0.72; }
  note n2 { at = 1q; dur = 1/2q; pitch = F5; velocity = 0.6; }
  note n3 { at = 3/2q; dur = 1/2q; pitch = D5; velocity = 0.6; }
  note n4 { at = 2q; dur = 1q; pitch = F5; velocity = 0.66; }
  note n5 { at = 3q; dur = 1/2q; pitch = G5; velocity = 0.64; }
  note n6 { at = 7/2q; dur = 1/2q; pitch = Bb5; velocity = 0.68; }
  note n7 { at = 4q; dur = 1q; pitch = A5; velocity = 0.7; }
  note n8 { at = 5q; dur = 1q; pitch = G5; velocity = 0.64; }
  note n9 { at = 6q; dur = 2q; pitch = D5; velocity = 0.7; }
  note n10 { at = 8q; dur = 1/2q; pitch = Eb5; velocity = 0.62; }
  note n11 { at = 17/2q; dur = 1/2q; pitch = F5; velocity = 0.62; }
  note n12 { at = 9q; dur = 1q; pitch = G5; velocity = 0.68; }
  note n13 { at = 10q; dur = 1q; pitch = Bb5; velocity = 0.72; }
  note n14 { at = 11q; dur = 1q; pitch = G5; velocity = 0.64; }
  note n15 { at = 12q; dur = 1q; pitch = F5; velocity = 0.66; }
  note n16 { at = 13q; dur = 1/2q; pitch = Eb5; velocity = 0.6; }
  note n17 { at = 27/2q; dur = 1/2q; pitch = D5; velocity = 0.6; }
  note n18 { at = 14q; dur = 2q; pitch = C5; velocity = 0.7; }
  note n19 { at = 16q; dur = 1/2q; pitch = D5; velocity = 0.62; }
  note n20 { at = 33/2q; dur = 1/2q; pitch = D5; velocity = 0.56; }
  note n21 { at = 17q; dur = 1q; pitch = F5; velocity = 0.66; }
  note n22 { at = 18q; dur = 3/2q; pitch = G5; velocity = 0.72; }
  note n23 { at = 39/2q; dur = 1/2q; pitch = F5; velocity = 0.6; }
  note n24 { at = 20q; dur = 1q; pitch = D5; velocity = 0.66; }
  note n25 { at = 21q; dur = 1/2q; pitch = C5; velocity = 0.6; }
  note n26 { at = 43/2q; dur = 1/2q; pitch = Bb4; velocity = 0.6; }
  note n27 { at = 22q; dur = 2q; pitch = C5; velocity = 0.7; }
  note n28 { at = 24q; dur = 1q; pitch = Bb4; velocity = 0.64; }
  note n29 { at = 25q; dur = 1/2q; pitch = C5; velocity = 0.6; }
  note n30 { at = 51/2q; dur = 1/2q; pitch = D5; velocity = 0.62; }
  note n31 { at = 26q; dur = 1q; pitch = Eb5; velocity = 0.68; }
  note n32 { at = 27q; dur = 1q; pitch = D5; velocity = 0.64; }
  note n33 { at = 28q; dur = 1/2q; pitch = C5; velocity = 0.6; }
  note n34 { at = 57/2q; dur = 1/2q; pitch = A4; velocity = 0.6; }
  note n35 { at = 29q; dur = 1/2q; pitch = Bb4; velocity = 0.62; }
  note n36 { at = 59/2q; dur = 1/2q; pitch = A4; velocity = 0.58; }
  note n37 { at = 30q; dur = 2q; pitch = G4; velocity = 0.7; }
}

// ---------------------------------------------------------------- the siren
curve whoop { clock = normalized; points = [(0, 0ct, linear), (1, 1200ct, step)]; }
pattern sirens { length = 4q;
  note s { at = 0q; dur = 4q; pitch = A4; velocity = 0.6; expression rise { kind = pitch; curve = &whoop; } }
}

// ---------------------------------------------------------------- the players
node kit { instrument = &studio.drums; params = { hat_level = 3.6; }; }
node snare { instrument = &studio.snare; }
node bass { instrument = &studio.bass; config = { voices = 4; }; params = { growl = 1.6; level = 1.1; }; }
node guitar { instrument = &studio.electric_guitar; config = { voices = 6; }; params = { drive = 1; mute = 0.1; tone = 16000Hz; pickup = 0.03; release = 25ms; pan = 0.25; level = 1.88; }; }
node organ { instrument = &basic.organ; config = { voices = 8; }; params = { pan = -0.25; level = 0.27; }; }
node reed { instrument = &melodica; config = { voices = 4; }; params = { pan = 0.1; level = 0.6; }; }
node wail { instrument = &siren; config = { voices = 2; }; params = { pan = -0.3; level = 0.15; }; }
track kit_hits { target = &kit:events; }
track snare_notes { target = &snare:events; }
track bass_notes { target = &bass:events; }
track guitar_notes { target = &guitar:events; }
track organ_notes { target = &organ:events; }
track reed_notes { target = &reed:events; }
track wail_notes { target = &wail:events; }

// The riddim runs from the end of the intro to the outro; the drums from the top.
// Each throw is written with the hit it throws, named by its repetition and leaf.
place drums_intro { pattern = &one_drop; track = &kit_hits; at = 0q; count = 4; groove = &lilt; }
place drums_main { pattern = &one_drop; track = &kit_hits; at = 16q; count = 36; vary = &hands; groove = &lilt; }
place drums_steppers { pattern = &steppers; track = &kit_hits; at = 160q; count = 13; vary = &hands; groove = &lilt; }
place snare_intro { pattern = &drop_snare; track = &snare_notes; at = 0q; count = 4; vary = &hands;
  automation bar_3 { event = "2/s"; target = &snare_send.params.gain; curve = &snare_throw; }
}
place snare_main { pattern = &drop_snare_ghost; track = &snare_notes; at = 16q; count = 49; vary = &hands; groove = &lilt;
  automation bar_14 { event = "9/s"; target = &snare_send.params.gain; curve = &snare_throw; }
  automation bar_18 { event = "13/s"; target = &snare_send.params.gain; curve = &snare_throw; }
  automation bar_19 { event = "14/s"; target = &snare_send.params.gain; curve = &snare_throw; }
  automation bar_20 { event = "15/s"; target = &snare_send.params.gain; curve = &snare_throw; }
  automation bar_30 { event = "25/s"; target = &snare_send.params.gain; curve = &snare_throw; }
  automation bar_32 { event = "27/s"; target = &snare_send.params.gain; curve = &snare_throw; }
  automation bar_36 { event = "31/s"; target = &snare_send.params.gain; curve = &snare_throw; }
  automation bar_38 { event = "33/s"; target = &snare_send.params.gain; curve = &snare_throw; }
  automation bar_52 { event = "47/s"; target = &snare_send.params.gain; curve = &snare_throw; }
}
place bass_main { pattern = &bass_line; track = &bass_notes; at = 16q; count = 12; vary = &hands; }
place bass_end { pattern = &bass_line; track = &bass_notes; at = 208q; count = 1; vary = &hands; }
place guitar_main { pattern = &skank; track = &guitar_notes; at = 16q; count = 13; harmony = &riddim; voicings = &skank_voicings; vary = &hands;
  automation bar_15 { event = "2/c6.0"; target = &guitar_send.params.gain; curve = &skank_throw; }
  automation bar_16 { event = "2/c8.0"; target = &guitar_send.params.gain; curve = &skank_throw; }
  automation bar_39 { event = "8/c6.0"; target = &guitar_send.params.gain; curve = &skank_throw; }
  automation bar_40 { event = "8/c8.0"; target = &guitar_send.params.gain; curve = &skank_throw; }
}
place guitar_last { pattern = &last_chord; track = &guitar_notes; at = 218q; harmony = &riddim; voicings = &skank_voicings;
  automation into_echo { event = "0/c.0"; target = &guitar_send.params.gain; curve = &skank_throw; }
}
place organ_main { pattern = &bubble; track = &organ_notes; at = 16q; count = 11; harmony = &riddim; voicings = &bubble_voicings; vary = &hands; groove = &lilt; }
place organ_end { pattern = &bubble; track = &organ_notes; at = 192q; count = 1; harmony = &riddim; voicings = &bubble_voicings; vary = &hands; groove = &lilt; }
place reed_a { pattern = &melody_a; track = &reed_notes; at = 16q; vary = &hands;
  automation end_1 { event = "0/n8"; target = &reed_send.params.gain; curve = &reed_throw; }
  automation end_2 { event = "0/n17"; target = &reed_send.params.gain; curve = &reed_throw; }
  automation end_3 { event = "0/n26"; target = &reed_send.params.gain; curve = &reed_throw; }
  automation end_4 { event = "0/n35"; target = &reed_send.params.gain; curve = &reed_throw; }
}
place reed_b { pattern = &melody_b; track = &reed_notes; at = 80q; vary = &hands;
  automation end_1 { event = "0/n9"; target = &reed_send.params.gain; curve = &reed_throw; }
  automation end_2 { event = "0/n18"; target = &reed_send.params.gain; curve = &reed_throw; }
  automation end_3 { event = "0/n27"; target = &reed_send.params.gain; curve = &reed_throw; }
  automation end_4 { event = "0/n37"; target = &reed_send.params.gain; curve = &reed_throw; }
}
place reed_c { pattern = &melody_a; track = &reed_notes; at = 160q; vary = &hands;
  automation end_1 { event = "0/n8"; target = &reed_send.params.gain; curve = &reed_throw; }
  automation end_2 { event = "0/n17"; target = &reed_send.params.gain; curve = &reed_throw; }
  automation end_3 { event = "0/n26"; target = &reed_send.params.gain; curve = &reed_throw; }
  automation end_4 { event = "0/n35"; target = &reed_send.params.gain; curve = &reed_throw; }
}
place wail_intro { pattern = &sirens; track = &wail_notes; at = 6q; }
place wail_dub { pattern = &sirens; track = &wail_notes; at = 136q; count = 2; }
place wail_out { pattern = &sirens; track = &wail_notes; at = 204q; }

// ---------------------------------------------------------------- the desk
// The drum bus: kit and snare through the sweep.
node drum_sum { type = "core.sum/1"; config = { channels = 2; }; }
connect kit_drums { from = &kit:out; to = &drum_sum:in; }
connect snare_drums { from = &snare:out; to = &drum_sum:in; }
node drum_sweep { effect = &sweep; }
connect drums_sweep { from = &drum_sum:out; to = &drum_sweep:in; }

// Faders.
node drum_fader { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 1; }; }
node bass_fader { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 1; }; }
node guitar_fader { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 1; }; }
node organ_fader { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 1; }; }
node reed_fader { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 1; }; }
connect sweep_fader { from = &drum_sweep:out; to = &drum_fader:in; }
connect bass_in { from = &bass:out; to = &bass_fader:in; }
node guitar_thin { effect = &thin; }
connect guitar_cut { from = &guitar:out; to = &guitar_thin:in; }
connect guitar_in { from = &guitar_thin:out; to = &guitar_fader:in; }
connect organ_in { from = &organ:out; to = &organ_fader:in; }
connect reed_in { from = &reed:out; to = &reed_fader:in; }

// Echo sends: closed unless thrown.
node snare_send { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 0; }; }
node guitar_send { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 0; }; }
node reed_send { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 0; }; }
connect snare_to_send { from = &snare:out; to = &snare_send:in; }
connect guitar_to_send { from = &guitar_fader:out; to = &guitar_send:in; }
connect reed_to_send { from = &reed_fader:out; to = &reed_send:in; }
// The echo loop: tape, wear, a partial swap of the sides so the repeats
// cross the field, one frame to break the cycle, and the regeneration gain.
// Above 1 the echo runs away, held by the wear's drive.
node echo { effect = &tape; }
node worn { effect = &wear; }
node cross { type = "core.matrix/1"; config = { inputs = 2; outputs = 2; coefficients = [[1/4, 3/4], [3/4, 1/4]]; }; }
node gap { type = "core.delay/1"; config = { channels = 2; frames = 1; }; }
node regen { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 0.55; }; }
connect snare_echo { from = &snare_send:out; to = &echo:in; }
connect guitar_echo { from = &guitar_send:out; to = &echo:in; }
connect reed_echo { from = &reed_send:out; to = &echo:in; }
connect echo_wear { from = &echo:out; to = &worn:in; }
connect wear_cross { from = &worn:out; to = &cross:in; }
connect cross_gap { from = &cross:out; to = &gap:in; }
connect gap_regen { from = &gap:out; to = &regen:in; }
connect regen_echo { from = &regen:out; to = &echo:in; }
node echo_spread { effect = &spread; }
connect wear_spread { from = &worn:out; to = &echo_spread:in; }
node echo_return { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 1; }; }
connect echo_back { from = &echo_spread:out; to = &echo_return:in; }
// The returns swing across the field once every two bars.
node swing_lfo { type = "core.lfo/1"; config = { period = 8q; }; }
modulate echo_swing { from = &swing_lfo:out; target = &echo_spread.params.balance; amount = 0.6; }

// The spring: the snare and the siren.
node spring_send { type = "core.sum/1"; config = { channels = 2; }; }
connect snare_spring { from = &snare:out; to = &spring_send:in; }
connect wail_spring { from = &wail:out; to = &spring_send:in; }
node spring { type = "fx.reverb/1"; config = { channels = 2; predelay = 10ms; damping = 0.3; }; params = { mix = 1; decay = 2.2s; }; }
node spring_return { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 0.6; }; }
connect spring_in { from = &spring_send:out; to = &spring:in; }
connect spring_back { from = &spring:out; to = &spring_return:in; }

node mix { type = "core.sum/1"; config = { channels = 2; }; }
connect drums_mix { from = &drum_fader:out; to = &mix:in; }
connect bass_mix { from = &bass_fader:out; to = &mix:in; }
connect guitar_mix { from = &guitar_fader:out; to = &mix:in; }
connect organ_mix { from = &organ_fader:out; to = &mix:in; }
connect reed_mix { from = &reed_fader:out; to = &mix:in; }
connect wail_mix { from = &wail:out; to = &mix:in; }
connect echo_mix { from = &echo_return:out; to = &mix:in; }
connect spring_mix { from = &spring_return:out; to = &mix:in; }
node glue { type = "fx.compressor/1"; config = { channels = 2; }; params = { threshold = -16dB; ratio = 2; knee = 6dB; attack = 15ms; release = 200ms; makeup = 0dB; }; }
node trim { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 1; }; }
node master { type = "fx.limiter/1"; config = { channels = 2; }; params = { gain = 0dB; ceiling = -1.1dB; release = 150ms; }; }
connect mix_glue { from = &mix:out; to = &glue:in; }
connect glue_trim { from = &glue:out; to = &trim:in; }
connect trim_master { from = &trim:out; to = &master:in; }

// ---------------------------------------------------------------- the dub
// The desk's moves. A throw opens a send for one hit and closes it; each is
// written in its placement, naming the hit it throws, so it moves with the
// music. Its level is its curve's.
curve snare_throw { clock = score; points = [(0q, 5/2, step), (1/2q, 0, step)]; }
curve skank_throw { clock = score; points = [(0q, 2, step), (1/4q, 0, step)]; }
curve reed_throw { clock = score; points = [(0q, 0.8, step), (2q, 0, step)]; }

// The intro opens the drums' low-pass; dub 2 sweeps the high-pass up and down.
curve sweep_low { clock = score; points = [(0q, 300Hz, exponential), (16q, 18000Hz, step)]; }
automation open_drums { target = &drum_sweep.params.low; curve = &sweep_low; at = 0q; }
curve sweep_high { clock = score; points = [(0q, 20Hz, exponential), (16q, 1500Hz, exponential), (28q, 20Hz, step)]; }
automation thin_drums { target = &drum_sweep.params.high; curve = &sweep_high; at = 128q; }

// Drop-outs: a part leaves for some bars and comes back.
curve out_2_bars { clock = score; points = [(0q, 0, step), (8q, 1, step)]; }
curve out_4_bars { clock = score; points = [(0q, 0, step), (16q, 1, step)]; }
curve out_7_bars { clock = score; points = [(0q, 0, step), (28q, 1, step)]; }
curve out_10_bars { clock = score; points = [(0q, 0, step), (40q, 1, step)]; }
curve out_12_bars { clock = score; points = [(0q, 0, step), (48q, 1, step)]; }
automation bass_out_dub_1 { target = &bass_fader.params.gain; curve = &out_2_bars; at = 64q; }
automation bass_out_dub_2 { target = &bass_fader.params.gain; curve = &out_2_bars; at = 136q; }
automation guitar_out_dub_1 { target = &guitar_fader.params.gain; curve = &out_2_bars; at = 48q; }
automation guitar_out_dub_1_again { target = &guitar_fader.params.gain; curve = &out_4_bars; at = 64q; }
automation guitar_out_dub_2 { target = &guitar_fader.params.gain; curve = &out_10_bars; at = 112q; }
automation organ_out_dub_1 { target = &organ_fader.params.gain; curve = &out_7_bars; at = 48q; }
automation organ_out_dub_2 { target = &organ_fader.params.gain; curve = &out_12_bars; at = 112q; }

// The echo runs away at the ends of the dubs and in the outro, then is cut
// back; in dub 2 the tape speeds up to an eighth and slows back.
curve runaway { clock = score; points = [(0q, 0.55, linear), (6q, 1.15, step), (8q, 0.55, step)]; }
curve last_runaway { clock = score; points = [(0q, 0.55, linear), (5q, 1.12, step), (6q, 0.75, step)]; }
automation runaway_dub_1 { target = &regen.params.gain; curve = &runaway; at = 72q; }
automation runaway_dub_2 { target = &regen.params.gain; curve = &runaway; at = 152q; }
automation runaway_outro { target = &regen.params.gain; curve = &last_runaway; at = 216q; }
curve speed_up { clock = score; points = [(0q, 3/4q, linear), (2q, 1/2q, step), (14q, 1/2q, linear), (16q, 3/4q, step)]; }
automation echo_speed { target = &echo.params.time; curve = &speed_up; at = 132q; }
curve fade { clock = score; points = [(0q, 1, linear), (2q, 0.6, step)]; }
automation echo_fade { target = &echo_return.params.gain; curve = &fade; at = 222q; }

// ---------------------------------------------------------------- delivery
asset schema { kind = descriptor; builtin = "maac.production/1"; }
extension deliveries {
  namespace = "maac.production/1"; schema = &schema; render_affecting = true;
  data = { deliveries = { release = {
    rate = 48000Hz; resampler = "maac.src.kaiser/1";
    targets = { master = {
      role = master; output = &master:out; encoding = wav_pcm24le;
      dither = { type = tpdf; seed = 2026; };
      limits = {
        integrated_loudness = { unit = LUFS; min = -18; max = -14; };
        true_peak = { unit = dBTP; max = -1; };
      };
    }; };
  }; }; };
}
