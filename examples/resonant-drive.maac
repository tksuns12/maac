maac 1;

// A saw bass through a key-tracked resonant low-pass, then a little
// asymmetric drive. A curved filter envelope opens each note; harder notes
// open it further and push the drive harder.
project resonant_drive_demo {
  score = [0q, 8q];
  tail = 500ms;
  rate = 48000Hz;
  tempo = &clock;
  meter = &metre;
  output = &bass:out;
}
tempo clock { points = [(0q, 100bpm, step)]; }
meter metre { points = [(0q, 4, 4)]; }

instrument acid_bass {
  channels = 1;
  voice v {
    channels = 1;
    amplitude = &amp;
    output = &clean:out;
    node amp {
      type = "synth.adsr/1";
      params = { attack = 3ms; decay = 600ms; sustain = 1/2; release = 120ms; curve = 6; };
    }
    node osc { type = "synth.saw/1"; params = { ratio = 1; level = 1/3; }; }
    node sweep {
      type = "synth.adsr/1";
      params = { attack = 1ms; decay = 350ms; sustain = 0; release = 100ms; curve = 5; };
    }
    node vel { type = "synth.velocity/1"; }
    // The cutoff sits at twice the note frequency plus 150 Hz, and the
    // envelope adds up to 2.4 kHz.
    node tone {
      type = "synth.svf/1";
      config = { channels = 1; mode = lowpass; };
      params = { cutoff = 150Hz; ratio = 2; q = 5; };
    }
    node grit {
      type = "synth.drive/1";
      config = { channels = 1; };
      params = { drive = 2; bias = 1/5; level = 1/2; };
    }
    node clean {
      type = "synth.highpass/1";
      config = { channels = 1; };
      params = { cutoff = 25Hz; };
    }
    connect osc_tone { from = &osc:out; to = &tone:in; }
    connect tone_grit { from = &tone:out; to = &grit:in; }
    connect grit_clean { from = &grit:out; to = &clean:in; }
    modulate open { from = &sweep:out; to = &tone.params.cutoff; depth = 2400Hz; }
    modulate harder_brighter { from = &vel:out; to = &tone.params.cutoff; depth = 900Hz; }
    modulate harder_grittier { from = &vel:out; to = &grit.params.drive; depth = 3; }
  }
}
node bass { instrument = &acid_bass; config = { voices = 4; }; }

pattern line {
  length = 4q;
  note n1 { at = 0q; dur = 1/2q; pitch = A1; velocity = 1; }
  note n2 { at = 1/2q; dur = 1/4q; pitch = A2; velocity = 0.4; }
  note n3 { at = 1q; dur = 1/2q; pitch = C2; velocity = 0.7; }
  note n4 { at = 3/2q; dur = 1/4q; pitch = A1; velocity = 0.3; }
  note n5 { at = 2q; dur = 1/2q; pitch = E2; velocity = 0.9; }
  note n6 { at = 5/2q; dur = 1/4q; pitch = G2; velocity = 0.5; }
  note n7 { at = 3q; dur = 1/2q; pitch = D2; velocity = 0.8; }
  note n8 { at = 7/2q; dur = 1/4q; pitch = E2; velocity = 0.35; }
}
track notes { target = &bass:events; }
place twice { pattern = &line; track = &notes; at = 0q; count = 2; }
