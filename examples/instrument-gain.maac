maac 1;

// Four independent gain envelopes across two embedded instrument collections.
project instrument_gain_demo {
  score = [0q, 3q]; rate = 48000Hz;
  tempo = &clock; meter = &metre; output = &master:out; tail = 400ms;
}
tempo clock { points = [(0q, 120bpm, step)]; }
meter metre { points = [(0q, 4, 4)]; }
import basic { builtin = "std/basic/1.0.0"; }
import acoustic { builtin = "std/acoustic/1.0.0"; }

node keys {
  instrument = &basic.mellow_piano; config = { voices = 4; };
  params = { level = 0.15; release = 300ms; };
}
node guitar {
  instrument = &acoustic.nylon_guitar; config = { voices = 4; };
  params = { level = 0.15; release = 300ms; };
}
node master { type = "core.sum/1"; config = { channels = 2; }; }
connect keys_master { from = &keys:out; to = &master:in; }
connect guitar_master { from = &guitar:out; to = &master:in; }

curve swell {
  clock = normalized;
  points = [(0, 0, linear), (1/2, 3/4, linear), (1, 0, step)];
}
curve rise {
  clock = seconds;
  points = [(0s, 1/8, exponential), (1s, 1/2, step)];
}
curve return_gain {
  clock = normalized;
  points = [(0, 1/2, step), (1/4, 0, step), (1/2, 1/2, linear), (1, 1/4, step)];
}
curve fade {
  clock = score;
  points = [(0q, 3/4, linear), (2q, 1/4, step)];
}
pattern piano_phrase {
  length = 3q;
  note swelling {
    at = 0q; dur = 2q; pitch = C4; velocity = 0.35;
    expression gain { kind = gain; curve = &swell; }
  }
  note rising {
    at = 1q; dur = 2q; pitch = E4; velocity = 0.3;
    expression gain { kind = gain; curve = &rise; }
  }
}
pattern guitar_phrase {
  length = 3q;
  note returning {
    at = 0q; dur = 2q; pitch = G3; velocity = 0.35;
    expression gain { kind = gain; curve = &return_gain; }
  }
  note fading {
    at = 1q; dur = 2q; pitch = C4; velocity = 0.3;
    expression gain { kind = gain; curve = &fade; }
  }
}
track piano { target = &keys:events; }
track strings { target = &guitar:events; }
place piano_once { pattern = &piano_phrase; track = &piano; at = 0q; }
place guitar_once { pattern = &guitar_phrase; track = &strings; at = 0q; }
