// Draft of the std/studio/1.1.0 `electric_guitar` (electric guitar and piano
// proposal, part 2). It stays out of the built-in libraries until the
// listening round approves it; scripts/guitar_auditions.py plays it inline.

// Electric guitar: a plucked string per voice, picked near the bridge and
// heard through a pickup, into one amp for all the strings: a low cut, a
// level-compensated drive, a DC cut, and a speaker cabinet with a resonant
// low end, 24 dB per octave above the tone cutoff and a presence peak.
// Harder picks are brighter and drive the amp harder; higher notes decay
// sooner. `drive` runs from clean at 1 to lead at 12 at about the same
// loudness.
instrument electric_guitar {
  channels = 2;
  voice voice {
    channels = 1;
    amplitude = &amp;
    output = &string:out;
    node amp {
      type = "synth.adsr/1";
      params = { attack = 1ms; sustain = 1; release = 120ms; };
    }
    node vel { type = "synth.velocity/1"; }
    node key { type = "synth.key/1"; }
    node string {
      type = "synth.pluck/1";
      config = { seed = 2654435761; };
      params = { decay = 6s; damping = 1/4; level = 1/2; hardness = 1/10; position = 1/8; pickup = 1/8; };
    }
    modulate higher_shorter { from = &key:out; to = &string.params.decay; depth = -1500ms; }
    // Velocity scales the voice once more before the amp, so its compression
    // still leaves soft and hard picks apart, and opens up the pick.
    modulate harder_louder { from = &vel:out; to = &string.params.level; depth = 1/2; }
    modulate harder_brighter { from = &vel:out; to = &string.params.hardness; depth = 17/20; }
    node vibrato { type = "synth.lfo/1"; params = { frequency = 5.5Hz; level = 0; }; }
    modulate string_vibrato { from = &vibrato:out; to = &string.params.ratio; depth = 0.0145; }
  }
  shared amp_stage {
    channels = 2;
    output = &gain:out;
    node low_cut {
      type = "synth.highpass/1";
      config = { channels = 1; };
      params = { cutoff = 100Hz; };
    }
    node input_trim {
      type = "synth.gain/1";
      config = { channels = 1; };
      params = { level = 1/4; };
    }
    node drive {
      type = "synth.drive/1";
      config = { channels = 1; };
      params = { drive = 4; bias = 1/5; level = 1; reference = 1/10; };
    }
    node dc_cut {
      type = "synth.highpass/1";
      config = { channels = 1; };
      params = { cutoff = 30Hz; };
    }
    // The cabinet: a resonant high-pass for the closed-back thump, two
    // low-passes for the speaker's steep top, and a presence peak mixed in.
    node thump {
      type = "synth.svf/1";
      config = { channels = 1; mode = highpass; };
      params = { cutoff = 90Hz; q = 1.4; };
    }
    node speaker_a {
      type = "synth.svf/1";
      config = { channels = 1; mode = lowpass; };
      params = { cutoff = 4500Hz; q = 0.9; };
    }
    node speaker_b {
      type = "synth.svf/1";
      config = { channels = 1; mode = lowpass; };
      params = { cutoff = 5000Hz; q = 0.6; };
    }
    node presence {
      type = "synth.svf/1";
      config = { channels = 1; mode = bandpass; };
      params = { cutoff = 2200Hz; q = 1.2; };
    }
    node presence_level {
      type = "synth.gain/1";
      config = { channels = 1; };
      params = { level = 0.35; };
    }
    node cabinet { type = "synth.mix/1"; config = { channels = 1; }; }
    node stereo { type = "synth.pan/1"; params = { pan = 0; }; }
    node gain {
      type = "synth.gain/1";
      config = { channels = 2; };
      params = { level = 1.06; };
    }
    connect input_cut { from = &input:out; to = &low_cut:in; }
    connect cut_trim { from = &low_cut:out; to = &input_trim:in; }
    connect trim_drive { from = &input_trim:out; to = &drive:in; }
    connect drive_dc { from = &drive:out; to = &dc_cut:in; }
    connect dc_thump { from = &dc_cut:out; to = &thump:in; }
    connect thump_a { from = &thump:out; to = &speaker_a:in; }
    connect a_b { from = &speaker_a:out; to = &speaker_b:in; }
    connect b_cabinet { from = &speaker_b:out; to = &cabinet:in; }
    connect thump_presence { from = &thump:out; to = &presence:in; }
    connect presence_trim { from = &presence:out; to = &presence_level:in; }
    connect presence_cabinet { from = &presence_level:out; to = &cabinet:in; }
    connect cabinet_stereo { from = &cabinet:out; to = &stereo:in; }
    connect stereo_gain { from = &stereo:out; to = &gain:in; }
  }
  control level { target = &amp_stage.gain.params.level; default = 1.06; }
  control drive { target = &amp_stage.drive.params.drive; default = 4; }
  control tone { target = &amp_stage.speaker_a.params.cutoff; default = 4500Hz; }
  control pickup { target = &voice.string.params.pickup; default = 1/8; }
  control mute { target = &voice.string.params.damping; default = 1/4; }
  control pan { target = &amp_stage.stereo.params.pan; default = 0; }
  control release { target = &voice.amp.params.release; default = 120ms; }
  control vibrato { target = &voice.vibrato.params.level; default = 0; }
}
