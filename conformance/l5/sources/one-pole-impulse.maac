asset impulse { kind = audio; path = "impulse.pcm"; hash = "sha256:66b7057e198043f4acfb86f84717e34610811559714e63c9484bde10fb7cbe06"; format = "pcm_f32le_interleaved/1"; rate = 48000Hz; channels = 1; frames = 8; }
