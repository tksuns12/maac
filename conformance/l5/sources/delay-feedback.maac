maac 1;
project p { score = [0q, 1/6000q]; tail = 1/12000s; rate = 48000Hz; tempo = &clock; meter = &metre; output = &sum:out; }
tempo clock { points = [(0q, 120bpm, step)]; }
meter metre { points = [(0q, 4, 4)]; }
node sine { type = "core.sine/1"; params = { attack = 0s; release = 0s; level = 1; }; }
node sum { type = "core.sum/1"; config = { channels = 1; }; }
node delay { type = "core.delay/1"; config = { channels = 1; frames = 1; }; }
node gain { type = "core.gain/1"; config = { channels = 1; }; params = { gain = 1/2; }; }
connect a_feedback { from = &gain:out; to = &sum:in; }
connect z_source { from = &sine:out; to = &sum:in; }
connect sum_delay { from = &sum:out; to = &delay:in; }
connect delay_gain { from = &delay:out; to = &gain:in; }
track notes { target = &sine:events; }
pattern phrase { length = 1/6000q; note n { at = 0q; dur = 1/6000q; pitch = 6000Hz; velocity = 1; } }
place play { pattern = &phrase; track = &notes; at = 0q; }
