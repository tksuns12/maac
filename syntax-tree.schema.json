{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScoreIR/1 typed syntax tree (not full semantic validation)",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "objects": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "$ref": "#/$defs/object"
      }
    }
  },
  "required": [
    "version",
    "objects"
  ],
  "additionalProperties": false,
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "number"
            },
            "n": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            },
            "d": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "required": [
            "t",
            "n",
            "d"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "quantity"
            },
            "n": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            },
            "d": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "u": {
              "enum": [
                "q",
                "s",
                "ms",
                "frame",
                "Hz",
                "kHz",
                "bpm",
                "ct",
                "dB"
              ]
            }
          },
          "required": [
            "t",
            "n",
            "d",
            "u"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "string"
            },
            "v": {
              "type": "string"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "symbol"
            },
            "v": {
              "type": "string"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "boolean"
            },
            "v": {
              "type": "boolean"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "ref"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "maxLength": 128
              },
              "minItems": 1
            },
            "port": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "t",
            "path",
            "port"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "call"
            },
            "fn": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "maxLength": 128
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "t",
            "fn",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "t",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "tuple"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              },
              "minItems": 2
            }
          },
          "required": [
            "t",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "record"
            },
            "fields": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "maxLength": 128
              },
              "additionalProperties": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "t",
            "fields"
          ],
          "additionalProperties": false
        }
      ]
    },
    "object": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 128
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "children": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/object"
          }
        }
      },
      "required": [
        "kind",
        "fields",
        "children"
      ],
      "additionalProperties": false
    }
  }
}
