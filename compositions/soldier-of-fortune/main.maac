// Controller bindings. Shared curves are reused only when all timing and values are identical.
automation steel_rhythm_level_motion { target = &steel_rhythm.params.level; curve = &steel_rhythm_level_curve; at = 0q; }
automation steel_rhythm_pan_motion { target = &steel_rhythm.params.pan; curve = &steel_rhythm_pan_curve; at = 0q; }
