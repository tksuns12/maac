// Detailed note patterns. There are no inferred verse/chorus labels or timing quantization.

// MIDI track 1: steel_rhythm; 370 notes.
pattern steel_rhythm_score {
  length = 424q;
  note n0000 { at = 4q; dur = 595/96q; pitch = G2; velocity = 75/127; release_velocity = 64/127; }
  note n0007 { at = 5q; dur = 643/192q; pitch = G3; velocity = 64/127; release_velocity = 64/127; }
  note n0010 { at = 6q; dur = 209/192q; pitch = A#3; velocity = 64/127; release_velocity = 64/127; }
