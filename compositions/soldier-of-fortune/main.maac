maac 1;

// Soldier of Fortune — editable canonical composition.
// This file is the source of truth. No MIDI JSON, generator, or stem file is needed to render it.
// User-supplied MIDI: https://bitmidi.com/uploads/38560.mid
// MIDI SHA-256: 6d54d5b1b8eb3c3fea7428eaf76db93bb52624f3a51ed1c66fa5f745d254f974
// 2,399 original notes; 14 original MIDI musical tracks; 24 native one-target instrument tracks.
// Read the arrangement and routing below; detailed patterns and controller curves follow.
// Numeric note IDs are retained for provenance. Instrument labels describe this rendition.

project soldier_of_fortune {
  label = "Soldier of Fortune — acoustic guitar rendition";
  score = [0q, 424q];
  rate = 48000Hz;
  tempo = &song_tempo;
  meter = &song_meter;
  output = &master:out;
  tail = 2s;
}

import acoustic { builtin = "std/acoustic/1.0.0"; }
import basic { builtin = "std/basic/1.0.0"; }

// Source tempo changes are exact rational BPM values derived from integer microseconds per quarter.
tempo song_tempo {
  points = [
    (0q, 750000/5639bpm, step),
    (4q, 1500000/14423bpm, step),
    (5q, 2000000/17391bpm, step),
    (85/16q, 30000000/206891bpm, step),
    (7q, 20000000/152667bpm, step),
    (32q, 100000/813bpm, step),
    (36q, 2000000/15267bpm, step),
    (64q, 500000/3937bpm, step),
    (68q, 2000000/15267bpm, step),
    (84q, 6000000/46511bpm, step),
    (96q, 6000000/46153bpm, step),
    (100q, 2000000/15267bpm, step),
    (392q, 2000000/16129bpm, step),
    (396q, 1000000/8547bpm, step),
    (400q, 80bpm, step),
    (404q, 750000/12931bpm, step),
    (408q, 6000000/46511bpm, step)
  ];
}
meter song_meter { points = [(0q, 4, 4)]; }

// Arrangement overview: original MIDI track -> native instrument track(s).
//  1: steel_rhythm (370 notes)
//  2: finger_bass (153 notes)
//  3: organ (220 notes)
//  4: nylon_figure_left (36 notes)
//  5: nylon_rhythm_left (351 notes)
//  6: nylon_rhythm_right (355 notes)
//  7: nylon_figure_right (35 notes)
//  8: kick, snare, floor_tom_low, floor_tom_high, pedal_hat, tom, open_hat, crash_1, ride_1, crash_2, ride_2 (534 notes)
//  9: tambourine (125 notes)
// 10: warm_strings (49 notes)
// 11: bright_strings (68 notes)
// 12: flute (38 notes)
// 13: steel_lead_left (32 notes)
// 14: steel_lead_right (33 notes)

// Instrument controls. Initial values apply before later MIDI controller events.
// Guitar level controls include acoustic calibration; all normalized MIDI CC7 values are retained.
// Master volume is applied once below, after the ensemble sum.

// Original MIDI track 1; MIDI channel 1.
node steel_rhythm {
  instrument = &acoustic.steel_guitar;
  config = { voices = 7; };
  params = { level = 28/127; brightness = 6500Hz; release = 240ms; pan = 0; bend_ratio = 1; vibrato_amount = 0; };
}

// Original MIDI track 2; MIDI channel 2.
node finger_bass {
  instrument = &basic.finger_bass;
  config = { voices = 4; };
  params = { level = 25/127; brightness = 700Hz; release = 160ms; pan = 0; };
}

// Original MIDI track 3; MIDI channel 3.
node organ {
  instrument = &basic.organ;
  config = { voices = 9; };
  params = { level = 14/127; brightness = 9000Hz; release = 110ms; pan = 0; };
}

// Original MIDI track 4; MIDI channel 6.
node nylon_figure_left {
  instrument = &acoustic.nylon_guitar;
  config = { voices = 6; };
  params = { level = 34/127; brightness = 3500Hz; release = 180ms; pan = 0; bend_ratio = 1; vibrato_amount = 0; };
}

// Original MIDI track 5; MIDI channel 7.
node nylon_rhythm_left {
  instrument = &acoustic.nylon_guitar;
  config = { voices = 6; };
  params = { level = 34/127; brightness = 3500Hz; release = 180ms; pan = 0; bend_ratio = 1; vibrato_amount = 0; };
}

// Original MIDI track 6; MIDI channel 8.
node nylon_rhythm_right {
  instrument = &acoustic.nylon_guitar;
  config = { voices = 6; };
  params = { level = 34/127; brightness = 3500Hz; release = 180ms; pan = 0; bend_ratio = 1; vibrato_amount = 0; };
}

// Original MIDI track 7; MIDI channel 9.
node nylon_figure_right {
  instrument = &acoustic.nylon_guitar;
  config = { voices = 6; };
  params = { level = 34/127; brightness = 3500Hz; release = 180ms; pan = 0; bend_ratio = 1; vibrato_amount = 0; };
}

// Original MIDI track 8; MIDI channel 10.
node kick {
  instrument = &basic.kick;
  config = { voices = 3; };
  params = { level = 25/127; brightness = 3500Hz; release = 90ms; pan = 0; };
}
node snare {
  instrument = &basic.snare;
  config = { voices = 2; };
  params = { level = 24/127; brightness = 8500Hz; release = 80ms; pan = 0; };
}
node floor_tom_low {
  instrument = &basic.low_tom;
  config = { voices = 3; };
  params = { level = 25/127; brightness = 4200Hz; release = 150ms; pan = 0; };
}
node floor_tom_high {
  instrument = &basic.low_tom;
  config = { voices = 3; };
  params = { level = 25/127; brightness = 5600Hz; release = 150ms; pan = 0; };
}
node pedal_hat {
  instrument = &basic.closed_hat;
  config = { voices = 2; };
  params = { level = 60/127; brightness = 10500Hz; release = 25ms; pan = 0; };
}
node tom {
  instrument = &basic.high_tom;
  config = { voices = 3; };
  params = { level = 25/127; brightness = 5000Hz; release = 100ms; pan = 0; };
}
node open_hat {
  instrument = &basic.open_hat;
  config = { voices = 2; };
  params = { level = 44/127; brightness = 12000Hz; release = 180ms; pan = 0; };
}
node crash_1 {
  instrument = &basic.crash;
  config = { voices = 2; };
  params = { level = 28/127; brightness = 12000Hz; release = 650ms; pan = 0; };
}
node ride_1 {
  instrument = &basic.open_hat;
  config = { voices = 3; };
  params = { level = 22/127; brightness = 12000Hz; release = 180ms; pan = 0; };
}
node crash_2 {
  instrument = &basic.crash;
  config = { voices = 2; };
  params = { level = 28/127; brightness = 12000Hz; release = 650ms; pan = 0; };
}
node ride_2 {
  instrument = &basic.crash;
  config = { voices = 6; };
  params = { level = 14/127; brightness = 12000Hz; release = 650ms; pan = 0; };
}

// Original MIDI track 9; MIDI channel 10.
node tambourine {
  instrument = &basic.closed_hat;
  config = { voices = 4; };
  params = { level = 27/127; brightness = 10500Hz; release = 25ms; pan = 0; };
}

// Original MIDI track 10; MIDI channel 12.
node warm_strings {
  instrument = &basic.strings;
  config = { voices = 6; };
  params = { level = 16/127; brightness = 3500Hz; release = 450ms; pan = 0; };
}

// Original MIDI track 11; MIDI channel 13.
node bright_strings {
  instrument = &basic.strings;
  config = { voices = 7; };
  params = { level = 16/127; brightness = 5500Hz; release = 450ms; pan = 0; };
}

// Original MIDI track 12; MIDI channel 14.
node flute {
  instrument = &basic.flute;
  config = { voices = 3; };
  params = { level = 16/127; brightness = 6500Hz; release = 160ms; pan = 0; };
}

// Original MIDI track 13; MIDI channel 15.
node steel_lead_left {
  instrument = &acoustic.steel_guitar;
  config = { voices = 4; };
  params = { level = 728/3175; brightness = 4200Hz; release = 240ms; pan = 0; bend_ratio = 1; vibrato_amount = 0; };
}

// Original MIDI track 14; MIDI channel 16.
node steel_lead_right {
  instrument = &acoustic.steel_guitar;
  config = { voices = 4; };
  params = { level = 28/127; brightness = 4200Hz; release = 240ms; pan = 0; bend_ratio = 1; vibrato_amount = 0; };
}

// Explicit stereo master routing and one editable master-volume control.
node ensemble_mix { type = "core.sum/1"; config = { channels = 2; }; }
node master { type = "core.gain/1"; config = { channels = 2; }; params = { gain = 1.846899574339569; }; }
connect route_01_steel_rhythm { from = &steel_rhythm:out; to = &ensemble_mix:in; }
connect route_02_finger_bass { from = &finger_bass:out; to = &ensemble_mix:in; }
connect route_03_organ { from = &organ:out; to = &ensemble_mix:in; }
connect route_04_nylon_figure_left { from = &nylon_figure_left:out; to = &ensemble_mix:in; }
connect route_05_nylon_rhythm_left { from = &nylon_rhythm_left:out; to = &ensemble_mix:in; }
connect route_06_nylon_rhythm_right { from = &nylon_rhythm_right:out; to = &ensemble_mix:in; }
connect route_07_nylon_figure_right { from = &nylon_figure_right:out; to = &ensemble_mix:in; }
connect route_08_kick { from = &kick:out; to = &ensemble_mix:in; }
connect route_09_snare { from = &snare:out; to = &ensemble_mix:in; }
connect route_10_floor_tom_low { from = &floor_tom_low:out; to = &ensemble_mix:in; }
connect route_11_floor_tom_high { from = &floor_tom_high:out; to = &ensemble_mix:in; }
connect route_12_pedal_hat { from = &pedal_hat:out; to = &ensemble_mix:in; }
connect route_13_tom { from = &tom:out; to = &ensemble_mix:in; }
connect route_14_open_hat { from = &open_hat:out; to = &ensemble_mix:in; }
connect route_15_crash_1 { from = &crash_1:out; to = &ensemble_mix:in; }
connect route_16_ride_1 { from = &ride_1:out; to = &ensemble_mix:in; }
connect route_17_crash_2 { from = &crash_2:out; to = &ensemble_mix:in; }
connect route_18_ride_2 { from = &ride_2:out; to = &ensemble_mix:in; }
connect route_19_tambourine { from = &tambourine:out; to = &ensemble_mix:in; }
connect route_20_warm_strings { from = &warm_strings:out; to = &ensemble_mix:in; }
connect route_21_bright_strings { from = &bright_strings:out; to = &ensemble_mix:in; }
connect route_22_flute { from = &flute:out; to = &ensemble_mix:in; }
connect route_23_steel_lead_left { from = &steel_lead_left:out; to = &ensemble_mix:in; }
connect route_24_steel_lead_right { from = &steel_lead_right:out; to = &ensemble_mix:in; }
connect route_master { from = &ensemble_mix:out; to = &master:in; }

// Every musical part is placed exactly once on the shared full-song timeline.
track steel_rhythm_track { label = "MIDI track 1: steel rhythm"; target = &steel_rhythm:events; }
place steel_rhythm_play { pattern = &steel_rhythm_score; track = &steel_rhythm_track; at = 0q; }
track finger_bass_track { label = "MIDI track 2: finger bass"; target = &finger_bass:events; }
place finger_bass_play { pattern = &finger_bass_score; track = &finger_bass_track; at = 0q; }
track organ_track { label = "MIDI track 3: organ"; target = &organ:events; }
